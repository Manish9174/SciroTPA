
{% assign curve_opacity = section.settings.curve_opacity | minus: 20 | times: 0.01  %}
{% style %}
  .section-{{ section.id }}-padding { position: relative; z-index: calc(100 - {{ section.index }}); }
  .section-{{ section.id }}-padding .wdt-separator.wdt-separator__stroke {
    overflow: visible;
    width: calc(100% + 40px);
    left: -20px;
    -webkit-transform: translate(0%, -10%);
    transform: translate(0%, -10%);
    z-index: 8;
  }
  .section-{{ section.id }}-padding .wdt-separator.wdt-separator__stroke .separator__stroke { stroke-width: 100; }
{% endstyle %}

{% if curve_class == 'top' or curve_class == 'both' %}
  <svg
    class="wdt-separator wdt-separator__stroke wdt-separator__top"
    viewBox="0 0 1920 154.3"
    preserveAspectRatio="none"
  >
    <path class="wdt__stroke_anim separator__stroke" id="text-path-item"
      d="M2.1,154.8C303,56.9,625.1,3.9,960,3.9c335,0,657.3,53.1,958.4,151" fill="none"
      stroke="rgba(var(--color-background), {{ curve_opacity }})" />
  </svg>
{% endif %}
{% if curve_class == 'bottom' or curve_class == 'both' %}
  <svg
    class="wdt-separator wdt-separator__stroke wdt-separator__down"
    viewBox="0 0 1920 154.3"
    preserveAspectRatio="none"
  >
    <path class="wdt__stroke_anim separator__stroke" id="text-path-item"

      d="M2.1,154.8C303,56.9,625.1,3.9,960,3.9c335,0,657.3,53.1,958.4,151" fill="none"
      stroke="rgba(var(--color-background), {{ curve_opacity }})" />
  </svg>
{% endif %}
