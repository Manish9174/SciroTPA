<recipient-form
  class="recipient-form"
  data-section-id="{{ section.id }}"
  data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
>
  <div class="customer">
    <div
      class="recipient-form"
      data-section-id="{{ section.id }}"
      data-product-variant-id="{{ product.selected_or_first_available_variant.id }}"
    >
      <div class="recipient-fields row">
      <!-- Name Field -->
        <div class="recipient-fields__field">
          <div class="field mb-3 mb-md-4">
            <label class="field__label h4" for="Recipient-name-{{ section.id }}">{{ "products.gift_card.recipient_form.name" | t }}</label>
            <input
              required class="field__input form-control shadow-none"
              autocomplete="name"
              type="text"
              id="Recipient-name-{{ section.id }}"
              name="properties[Recipient name]"
              placeholder="{{ "products.gift_card.recipient_form.name" | t }}"
            >
          </div>
        </div>

        <!-- Email Field -->
        <div class="recipient-fields__field">
          <div class="field mb-3 mb-md-4">
            <label class="field__label h4" for="Recipient-email-{{ section.id }}">{{ 'products.gift_card.recipient_form.email' | t }}*</label>
            <input
              required class="field__input field__inputEmail form-control shadow-none"
              id="Recipient-email-{{ section.id }}"
              type="email"
              placeholder="{{ 'products.gift_card.recipient_form.email' | t }}"
              name="properties[Recipient email]" 
            >
          </div>
        </div>
        <!-- Message Field -->
        <div class="recipient-fields__field">
          <div class="field mb-3 mb-md-4">
            <label class="form__label field__label h4 " for="Recipient-message-{{ section.id }}">{{ 'products.gift_card.recipient_form.message' | t }}</label>
            <textarea
              required rows="4"
              id="Recipient-message-{{ section.id }}"
              class="text-area field__input form-control rounded-5 shadow-none"
              name="properties[Message]"
              maxlength="200"
              placeholder="{{ 'products.gift_card.recipient_form.message' | t }}"
            ></textarea>
          </div>
        </div>

        <!-- Send on Date Field -->
        <div class="recipient-fields__field">
          <div class="field mb-3">
            <label class="form__label field__label h4" for="Recipient-send-on-{{ section.id }}">{{ 'products.gift_card.recipient_form.date' | t }}</label>
            <input
              required class="field__input form-control shadow-none"
              autocomplete="send_on"
              type="date"
              id="Recipient-send-on-{{ section.id }}"
              name="properties[Send on]"
              pattern="\d{4}-\d{2}-\d{2}"
              min="{{ 'now' | date: '%Y-%m-%d' }}"
              placeholder="{{ 'products.gift_card.recipient_form.placeholder_date' | t }}"
            >
          </div>
        </div>
      </div>

      <!-- Hidden Fields -->
      <input
        type="hidden"
        name="properties[__shopify_send_gift_card_to_recipient]"
        value="if_present"
        id="Recipient-control-{{ section.id }}"
      >
      <input
        type="hidden"
        name="properties[__shopify_offset]"
        value=""
        id="Recipient-timezone-offset-{{ section.id }}"
        disabled
      >
    </div>
  </div>
</recipient-form>
