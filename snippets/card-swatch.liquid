 <div class="swatches_container d-flex flex-wrap gap-2{% if settings.card_text_align == "center" %} justify-content-center{% elsif settings.card_text_align == "right" %} justify-content-end{% endif %}">
  {%- for option in card_product.options_with_values -%}
    {% assign map_color = settings.map_color_option | default: 'color' | downcase | split: ',' %}
    {% assign option_name_down = option.name | downcase %}

    {% if map_color contains option_name_down %}
      {% assign max_visible = 4 %}
      {% assign total_with_swatch = 0 %}

      {%- for variant_value in option.values -%}
        {% if variant_value.swatch %}
          {% if variant_value.swatch.image or variant_value.swatch.color %}
            {% assign total_with_swatch = total_with_swatch | plus: 1 %}
          {% endif %}
        {% endif %}
      {%- endfor -%}

      {% assign visible_count = 0 %}
      {%- for variant_value in option.values -%}
        {% if variant_value.swatch %}
          {% if variant_value.swatch.image or variant_value.swatch.color %}
            {% assign visible_count = visible_count | plus: 1 %}
            <span
              tabindex="0"
              class="swatch btn border-0{% if variant_value.swatch.image %} swatch--image{% else %} swatch--color{% endif %}{% if visible_count > max_visible %} swatch--extra swatch--hidden{% endif %}"
              style="
                {% if variant_value.swatch.image %}
                  background-image: url('{{ variant_value.swatch.image | image_url: width: 50 }}');
                  background-size: cover;
                  background-position: center;
                {% else %}
                  background-color: {{ variant_value.swatch.color }};
                {% endif %}
                width: 25px;
                height: 25px;
                display: inline-block;
                padding: 0;
                {% if settings.color_style == 'circle' %}
                  border-radius: 50px;
                {% else %}
                  border-radius: 0;
                {% endif %}
              "
              title="{{ variant_value.name }}"
              data-option-value="{{ variant_value.name | escape }}"
              data-image="{% if variant_value.variant and variant_value.variant.image %}{{ variant_value.variant.image | image_url: width: 768 }}{% else %}{{ card_product.featured_media | image_url: width: 768 }}{% endif %}"
            ></span>
          {% endif %}
        {% endif %}
      {%- endfor -%}

      {% if total_with_swatch > max_visible %}
        {% assign extra_count = total_with_swatch | minus: max_visible %}
        <button
          type="button"
          class="swatch swatch--more"
          data-swatch-toggle
          aria-expanded="false"
        >
          {% render 'icon-plus' %} <span class="d-flex ms-1 lh-0">{{ extra_count }}</span>
        </button>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>

{% stylesheet %}
  .swatch--hidden {
    display: none !important;
  }

  .swatch--more {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    border: 0;
    background: transparent;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function(event) {
    var toggle = event.target.closest('[data-swatch-toggle]');
    if (!toggle) return;

    var container = toggle.closest('.swatches_container');
    if (!container) return;

    var hiddenSwatches = container.querySelectorAll('.swatch--extra');
    var isExpanded = toggle.getAttribute('aria-expanded') === 'true';

    hiddenSwatches.forEach(function(swatch) {
      swatch.classList.toggle('swatch--hidden', isExpanded);
    });

    toggle.setAttribute('aria-expanded', String(!isExpanded));

    if (isExpanded) {
      var totalWithSwatch = hiddenSwatches.length + container.querySelectorAll('.swatch:not(.swatch--extra)').length;
      var maxVisible = totalWithSwatch - hiddenSwatches.length;
      var extraCount = totalWithSwatch - maxVisible;
      toggle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M5.34944 3.88805H9.47744V5.13605H5.34944V9.26405H4.10144V5.13605H-0.00256243V3.88805H4.10144V4.64916e-05H5.34944V3.88805Z" fill="currentcolor"/></svg>' + "<span></span>" +extraCount;
    } else {
      toggle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="9" height="2" viewBox="0 0 9 2" fill="none"><path d="M8.11456 -1.50204e-05V1.24799H0.00256252V-1.50204e-05H8.11456Z" fill="currentcolor"/></svg>';
    }
  });
{% endjavascript %}