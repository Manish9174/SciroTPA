<ul id="social_icons" class="d-flex flex-wrap p-0 m-0 text-decoration-none gap-3 {% if class %} {{ class}}{% endif %}" role="list">
  {%- if settings.social_facebook_link != blank -%}
    <li class="social_icons-item {% unless socialText  %}rounded-circle{% endunless  %}">
      <a
        href="{{ settings.social_facebook_link }}"
        class="text-decoration-none {% unless socialText  %}d-flex p-2{% endunless  %}"
        title="{{ 'general.social.icons.facebook' | t }}"
      >
        <span class="{%- unless socialText  %} visually-hidden {% endunless  %}social-text">{{ 'general.social.icons.facebook' | t }}</span>
        {%- render 'social-icon-facebook' -%}
      </a>
    </li>
