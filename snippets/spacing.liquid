{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.top_space | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.bot_space | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.top_space | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.bot_space | times: 0.75 | round: 0 }}px;
    }
  }
  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.top_space }}px;
      padding-bottom: {{ section.settings.bot_space }}px;
    }
  }
{%- endstyle -%}