  }

  @keyframes rotating {
    100% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  .rotating {
    animation: rotating 15s linear infinite;
  }

  @keyframes coloring {
    0%,
    100% {
      fill:rgb(var(--color-secondary-button-text));
    }
  }
  .coloring {
    animation: coloring 12s linear infinite;
  }

   
  .rounded_container .round-title h3{
