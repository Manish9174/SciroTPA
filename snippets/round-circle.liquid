{% style %}
  .rounded-text {
    text-transform: uppercase;
    color: rgb(var(--color-secondary-button-text));
  }
  .pointer-none{
    pointer-events:none;
  }
  .round-title .strech-link {
    width: 100%;
    height: 100%;
    position: absolute;
    border-radius: 50%;
  }
 .round-title .strech-link:focus-visible{
      outline-offset: 0px;
 }
  .main_container{
    --width:455px;
      background: rgb(var(--color-secondary-button-bg));
      width: var(--width);
      aspect-ratio: 1 / 1;
      position: absolute;
      right: 0;
      left: 0;
      margin: auto;
      border-radius: 50%;
      z-index: 1024;
      bottom: 0;
    transform:translateY(70%);
    /* transform: translateY(46%); */
    /* animation-name: slideIn;
  animation-delay: 2s;
  animation-duration: 1s;
  animation-fill-mode: forwards; */
  }
  /* @keyframes slideIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
} */
  .rounded_container{
    position: absolute;
    z-index: calc(100 - {{ section.index }});
    bottom: 0;
    top:0;
    right: 0;
    left: 0;
    margin: auto;
    width: 430px;
    height: 430px;
    border-radius:50%;
    overflow:hidden;
    background: rgb(var(--color-secondary-button-bg));
    color: rgb(var(--color-secondary-button-text));
  }
  .strech-link::after{
    content:'';
    position:absolute;
    top:0;
    bottom:0;
    left:0;
    right:0;
    border-radius: 50%;
  }
  .rounded_container .round-title{
      width: 325px;
      height: 325px;
      background: rgba(var(--color-background));
  }
.round-title .title{
  font-size: clamp(2.1875rem, 1.3875rem + 4vw, 6.1875rem);
  }

