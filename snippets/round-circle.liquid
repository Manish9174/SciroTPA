  .rounded_container .round-title:has(a:focus-visible) {
    /* outline-color: rgba(var(--color-background)); */
    outline: 2px solid currentcolor !important;
  outline: -webkit-focus-ring-color solid 2px; 
}

{% endstyle %}

<div class="main_container">
  <div class="rounded_container">
    <div class="rounded-text rotating position-relative">
      <svg viewBox="0 0 200 200">
        <path id="textPath" d="M 85,0 A 85,85 0 0 1 -85,0 A 85,85 0 0 1 85,0" transform="translate(100,100)" fill="none" stroke-width="0"></path>
        <g font-size="13.1px">
          <text text-anchor="start">
            <textPath class="coloring" data-dx="20" xlink:href="#textPath" startOffset="0%" id="textPathElement">
              <!-- tspan elements will be added here -->
            </textPath>
          </text>
        </g>
      </svg>
    </div>
    <div class="round-title position-absolute inset-0 m-auto rounded-circle d-flex flex-column justify-content-center align-items-center">
      <h2 class="title m-0 text-center"> {{ 'general.card.all' | t }} </h2>
      <h3 class="h2 m-0 text-break text-center"> {{ 'general.password_page.product' | t }} </h3>
      <a href="{{ heading_url }}" class="strech-link {% if heading_url == blank %} pointer-none{% endif %}" aria-label="{{ 'sections.feature_collection.view_all' | t }}"></a>
    </div>{{ 'sections.feature_collection.view' | t }}
  </div>
</div>
<script>
  const viewText = {{ 'sections.feature_collection.view' | t | json }};
</script>
<script>
 
 
function updateTextPath(textPathElement) {
  if (!textPathElement || typeof textPathElement.appendChild !== 'function') {
    {% comment %} console.warn('Invalid textPathElement:', textPathElement); {% endcomment %}
    return;
  }

  // Clear existing tspans
  textPathElement.innerHTML = '';

  const iterations = window.innerWidth < 575 ? 9 : 10;

  for (let i = 0; i < iterations; i++) {
    const tspanStar = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
    tspanStar.textContent = "*";
    tspanStar.setAttribute("dx", "8");
    tspanStar.setAttribute("style", "font-size: 15px; font-family: Newsreader, serif;");

    const tspanView = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
    tspanView.textContent = viewText;
    tspanView.setAttribute("dx", "5");
    tspanView.setAttribute("style", "font-size: 15px; font-family: Newsreader, serif;");

    textPathElement.appendChild(tspanStar);
    textPathElement.appendChild(tspanView);
  }
}

function observeForTextPaths() {
  const observer = new MutationObserver((mutations, obs) => {
    const textPaths = document.querySelectorAll('textPath, textpath');
    if (textPaths.length > 0) {
      textPaths.forEach((tp) => {
        if (tp instanceof SVGTextPathElement || tp.tagName.toLowerCase() === 'textpath') {
          updateTextPath(tp);
        }
      });
      obs.disconnect(); // Done observing once we found them
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
}

// Run on DOM ready
document.addEventListener('DOMContentLoaded', () => {
  observeForTextPaths();
});
document.addEventListener('shopify:section:reload', observeForTextPaths());
document.addEventListener('shopify:section:load', observeForTextPaths()); 
  document.addEventListener('shopify:section:change', observeForTextPaths()); 
  document.addEventListener('shopify:block:change', observeForTextPaths()); 





  

// Initial call to set up the elements
updateTextPath();

// Update on window resize
window.addEventListener('resize', updateTextPath);

</script>
