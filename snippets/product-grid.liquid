    .main_collection #product-grid>* { width: 50%; transition: all 0.3s linear; }
    .filter_top_bar:has(.two_column) + .sidebar>.main_collection #product-grid>*{  width: 50%; transition:all 0.3s linear ;}
    @media (min-width: 992px) {
