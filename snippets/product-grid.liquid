       .filter_top_bar:has(.four_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even){ margin-top: 0 !important; }
       /* .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even){margin-top: 0 !important;} */
       .main_collection.mobile_layout_two :is(.main-card .card .card-body){ padding-bottom: 0 !important; }
       {% else %}
       .filter_top_bar:has(.four_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even){ margin-top: 1.5rem !important; }
       .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even),
       .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(3n+2),
       .filter_top_bar:has(.four_column) + .sidebar>.main_collection #product-grid .sm-mt-14
       {margin-top: 1.5rem !important;}
       .main_collection .product-card{ margin-top:1.5rem; width:100% !important; }
       {% endif %}

       {% if settings.card_align == "standard" %}
       .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card,
       .filter_top_bar:has(.four_column) + .sidebar>.main_collection #product-grid .product-card,
       .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even),
       .filter_top_bar:has(.three_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(3n+2),
       .filter_top_bar:has(.four_column) + .sidebar>.main_collection #product-grid .product-card:nth-child(even)
       { margin-top: 1rem !important; }

       {% endif %}
    }


    @media (max-width: 480px) {
      {% if card_alignment == "normal" %}
      .main_collection.mobile_layout_one .product-card{ width:100% !important; }
      {% else %}
      .main_collection.mobile_layout_one .product-card .main-card { width: 100% !important; }
      {% endif %}
    }
    @media (max-width: 390px){
      {% if card_alignment == "normal" %}
      .main_collection.mobile_layout_one .product-card .main-card{ width:100% !important; }
      {% else %}
      .main_collection.mobile_layout_one .product-card .main-card { width: 100% !important; }
      {% endif %}
