      .mobile_card_drawer{ max-width:80%;}
    }
    .main_collection .facet-filters:has(.filtered_items:empty) {
        display: none;
    }
    /* .sorting ul li[selected] {
        background: rgba(var(--color-foreground), .1);
    } */



  /* .main-product.row-cols-md-3 :is(.card-title) {
      font-size: calc(var(--h2) - 10px);
  }
  .main-product.row-cols-lg-4 :is(.card-title) {
      font-size: calc(var(--h2) - 20px);
  } */

{% if mobile_post == "2" %}
  @media (max-width: 575.98px) {
  .card-body{ padding: .5rem !important;}
}
{% endif %}

@media (max-width:425px){
  .mobile_card_drawer{ max-width:95%;}
  .sliders_control input[type="range"]{ width:100%; }
}



{% endstyle %}

{% liquid
  assign display_filters = true

  if template == 'search'
    assign source = search
    assign filters = search.filters
    assign products_count = search.results | size
    assign sort_by = search.sort_by | default: search.default_sort_by

    unless search.performed
      assign display_filters = false
    endunless

  else
    assign source = collection
    assign filters = collection.filters
    assign products_count = collection.products_count
    assign sort_by = collection.sort_by | default: collection.default_sort_by
  endif

  assign column = ''
  case desktop_columns
    when 2
      assign column = 'two_column'
      assign two_column = 'two_column'
    when 3
      assign column = 'three_column'
    when 4
      assign column = 'four_column'
      assign four_column = 'four_column'
    else
      assign column = 'two_column'
  endcase

  assign decorator_canvas = settings.seperator_line
%}

<div class="toggle_filter"></div>
<div class="collection-container">
  <div class="main-collection">
    {%- if products_count != 0 -%}
       <!-- change  the condition in filter issue -->
        <div class="filter_top_bar {% if search.terms %} filter_top_bar_active {% else %} filter_top_bar_active {% endif %}">
          <div class="filter_container {{ column }}">
            {% unless show_filter == blank %}
              <div class="topbar-menu d-flex gap-3">
                <div class="filter_heading">
                  <div class="d-flex align-items-center gap-2 w-auto text-dark">
                    {% if filter_style != 'drawer' %}
                      <div class="filter_title d-none d-lg-flex">
                        <button
                          id="sidebar_collapse"
                          class="btn btn-primary d-flex gap-2 align-items-center h-100"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#sidebar_collapse"
                          aria-expanded="false"
                          aria-controls="sidebar_collapse"
                        >
                          {% render 'filter-icon' -%}
                          <span class="text-uppercase showhide_filter"> {{ 'products.facets.hide_filter' | t }}</span>
                        </button>
                      </div>
                    {% endif %}
                    {% unless show_filter == blank %}
                      {% if filter_style == 'drawer' or filter_style == 'sidebar' %}
                        <div class="filter_menu">
                          <a
                            class="btn btn-primary text-decoration-none fw-bold d-flex align-items-center gap-2 w-auto flex-wrap"
                            data-bs-toggle="offcanvas"
                            href="#filterOffCanvas"
                            role="button"
                            aria-controls="filterOffCanvas" data-bs-backdrop="true" data-bs-scroll="false"
                          >
                            {% render 'filter-icon' -%}
                            <span> {{ 'products.facets.all_filters' | t }}</span>
                          </a>
                        </div>
                      {% endif %}
                    {% endunless %}
                  </div>
                </div>
              </div>
            {% endunless %}

            <div class="sort d-flex align-items-center justify-content-end flex-wrap column-gap-2">
              {% if product_count %}
                <div class="product_count {% if show_sorting != false %}me-5{% endif %}">
                  <span class="filter_totalcount">
                    {{- collection.products_count }}
                    {{ search.results_count }}
                  </span>
                  <span>
                    {% if search.results_count %}
                      {% if search.results_count > 1 %}
                        {{ 'products.facets.results' | t }}
                      {% else %}
                        {{ 'products.facets.result' | t }}
                      {% endif %}
                    {% endif %}
                    {% if collection.products_count %}
                      {% if collection.products_count > 1 %}
                        {{ 'products.facets.results' | t }}
                      {% else %}
                        {{ 'products.facets.result' | t }}
                      {% endif %}
                    {% endif %}
                  </span>
                </div>
              {% endif %}

              {% if show_sorting %}
                <div class="sorting-count align-items-center d-flex flex-wrap gap-2 sorting-count justify-content-sm-end">
                  <div class="sorting d-sm-block ">
                    <div class="sorting_hidden d-none">
                      <label
                        aria-label="{{ 'accessibility.sorting' | t }}"
                        class="align-items-center d-flex gap-2 justify-content-center bg-transparent"
                      >
                        {% render 'sorting' %}
                        {{ 'products.facets.sort_by_label' | t }}
                      </label>
                      <select
                        name="sort_by"
                        class="sorting_select facet-filters-sorting-select border-0"
                        id="SortBy"
                      >
                        {%- for option in source.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                    <div class="dropdown sorting_duplicate px-0 py-1">
                      <button
                        class="btn border-0 dropdown-toggle px-0 py-2 ps-sm-2 d-flex gap-2"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                      >
                        {%- for option in source.sort_options -%}
                          {% if option.value == sort_by %}{{ option.name | default: 'Sort by' }}{% endif %}
                        {%- endfor -%}
                      </button>
                      <ul class="dropdown-menu p-0">
                        {%- for option in source.sort_options -%}
                          <li
                            data-value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                            class=""
                          >
                            <a href="#" class="py-1 px-3 text-decoration-none d-block">{{ option.name | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>

      <div class="sidebar {% if filter_style == "sidebar" %}d-flex d-lg-grid pt-0 pt-lg-4{% endif %}">
        <!-- sidebar-filter -->

        {% if show_filter != blank %}
          {% if filter_style == 'sidebar' %}
            <div class="sidebar_container d-none d-lg-block">
              <div
                class="collapse collapse-horizontal {% if filter_style == "sidebar" %}col{% endif %} show"
                id="sidebar_collapse"
              >
                <div class="card me-5 form-1 sidebar_filter h-100" id="sidebar_filter">
                  {% render 'sidebar-filter',
                    filter_style: filter_style,
                    filter_count: filter_count,
                    enable_toggle: enable_toggle,
                    new_style: 'filter_forsidebar',
                    filterEle: 'filterEle1'
                  %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}

        <!-- end sidebar-filter -->

        <!-- main-products -->

        <div class="product-check" hidden>
          {%- for filter in filters -%}
            {%- for filter_value in filter.values -%}
              <label for="hidElemenet-filter-{{ filter.param_name }}-{{ filter_value.value }}" class="visually-hidden">{{ filter.param_name }}</label>
              <input
                aria-label="{{ filter_value.count }}"
                type="text"
                id="hidElemenet-filter-{{ filter.param_name }}-{{ filter_value.value }}"
                data-param="{{ filter_value.param_name }}"
                data-id="Filter-{{ filter.param_name }}-{{ filter_value.value }}"
                value="{{ filter_value.count }}"
              >
            {%- endfor -%}
          {%- endfor -%}
        </div>

        <div class="main_collection {% if mobile_post == "1" %}mobile_layout_one{% else %}mobile_layout_two{% endif %}{% if filter_style == "sidebar" and show_filter != blank %} col sidebar_filter{% endif %}">
          {% render 'sidebar-filter',
            filter_style: filter_style,
            filter_count: filter_count,
            new_style: 'filter_fortab',
            filterEle: 'filterEle2'
          %}

          <div
            id="product-grid"
            class="main-product pt-3 pt-sm-4 {% if settings.card_align != 'card' %} gy-3 {% endif %} {% if settings.card_align != 'card' and  card_alignment == 'normal' %} row-gap-0 row-gap-2 {% endif %} {% if card_alignment == 'normal' and  settings.card_align == 'card' %} gy-sm-4  {% endif %} {% if card_alignment == 'normal' and  settings.blog_card_align == 'card' %} gy-4{% endif %} row position-relative  {% if filter_style == 'sidebar' %}pt-lg-0{% else %} pt-lg-4 {% endif %}"
          >
            {% if template == 'search' %}
              {%- paginate search.results by post_limit -%}
                {%- for item in search.results -%}
                  {%- assign index = forloop.index -%}


                  {% comment %} this condition index of value value get  {% endcomment %}

                  {% if desktop_columns == 2 %}
                    {%- assign is_even = index | modulo: 2 -%}
                  {% elsif desktop_columns == 4 %}
                    {%- assign is_even = index | modulo: 2 -%}
                    {%- assign even = index | modulo: 3 -%}
                  {% elsif desktop_columns == 3 %}
                    {%- assign is_even = index | modulo: 3 -%}
                  {% endif %}

                  {% comment %} this condition gat value apply in number of column {% endcomment %}

                  {%- capture margin_top -%}
                    {%- if desktop_columns == 2 -%}
                        {%- if is_even == 1 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                    {%- elsif desktop_columns == 4 -%}
                        {%- if is_even == 1 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                        {% if even == 2 and card_alignment == 'stepped' %} even{%- endif -%}
                      {%- elsif desktop_columns == 3 -%}
                        {%- if is_even == 2 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                      {%- endif -%}
                  {%- endcapture -%}

                  {%- capture col_width -%}
                    {%- if card_alignment == 'normal' -%}
                          col-12
                        {%- elsif column and card_alignment == 'stepped' -%}
                          col-12 col-md-11
                        {%- endif -%}
                  {%- endcapture -%}




                  {% comment %} {%- if item.object_type == 'product' -%} {% endcomment %}
                  <div class="search-results-list-item search-results-product product-card {{ margin_top }}">
                    <div class="row {% if card_alignment == 'normal' and settings.card_align == 'card' %}h-100{% endif %}">
                      <div class="main-card {{ col_width }}">
                        {% if item.object_type == 'product' %}
                          {% render 'card-product',
                            card_product: item,
                            prefix: 'search-results-product',
                            aspect_ratio: aspect_ratio,
                            secondary_img: secondary_img,
                            show_inventory: show_inventory,
                            show_vendor: show_vendor,
                            show_swatches: show_swatches,
                            enable_quickview: enable_quickview,
                            enable_add_to_cart: enable_add_to_cart,
                            show_product_type: show_product_type
                          %}
                        {% elsif item.object_type == 'article' %}
                          <div class="article-card">
                            <div class="row">
                              <div class="search-results-list-item col-12 {% if card_alignment == 'stepped' %}col-xxl-12{% endif %}">
                                <div class="blog_card card color-{{ settings.blog_card_background }}{% if settings.blog_card_align == "card" %} blog-article{% else %} bg-transparent{% endif %}">
                                  {% if section.settings.show_image %}
                                    <div class="card-img  {% if settings.blog_card_align == "standard" %} blog-article{% endif %}" >
                                    <div class="ratio {{ aspect_ratio }} overflow-hidden" style="{% if article.image != blank %}--aspect-ratio: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;{% else %}--aspect-ratio:100%{% endif %}">
                                      {% if item.image != blank %}
                                        <a href="{{ item.url }}">
                                          {{-
                                            item.image
                                            | image_url: width: 1500
                                            | image_tag:
                                              aria_hidden: 'true',
                                              loading: 'lazy',
                                              class: 'img-fluid',
                                              width: article.image.width,
                                              height: article.image.height,
                                              sizes: '(min-width: 750px) 50vw, 100vw',
                                              alt: article.image.alt
                                            | escape
                                          -}}
                                        </a>
                                      {% else %}
                                        <div
                                          class="ratio {{ aspect_ratio }} overflow-hidden"
                                          style="--aspect-ratio: 100%;"
                                        >
                                          {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
                                        </div>
                                      {% endif %}
                                      </div>
                                    </div>
                                  {% endif %}
                                  <div class="card-body {% if settings.blog_card_align != "card" %}px-0{% endif %}{% if settings.blog_text_align == "center" %} text-center{% elsif settings.blog_text_align == "right" %} text-end{% endif %}">

                                  {% if section.settings.show_date or section.settings.show_author or section.settings.show_comments %}
                                    <div class="blog_details d-flex flex-wrap align-items-center mb-2 gap-3 row-gap-1 {% if settings.blog_text_align == "center" %} justify-content-center{% elsif settings.blog_text_align == "right" %} justify-content-end{% endif %}">

                                      {% if section.settings.show_date %}
                                          <div class="meta-item blog_date">
                                            <span class="seperator-circle"></span>
                                            <span>{{ item.published_at | date: '%d %B, %Y' }}</span>
                                          </div>
                                        {% endif %}

                                        {% if section.settings.show_author %}
                                          <div class="meta-item author_name">
                                            <span class="seperator-circle"></span>
                                            <span class="author">{{ item.author }}</span>
                                          </div>
                                        {% endif %}

                                        {% if section.settings.show_comments %}
                                          {% assign count = item.comments_count %}
                                          <div class="meta-item comment">
                                            <span class="seperator-circle"></span>
                                            <span>
                                              {% if count == 1 %}
                                                {{ 'sections.blogs.article.comments.one' | t: count: count }}
                                              {% else %}
                                                {{ 'sections.blogs.article.comments.other' | t: count: count }}
                                              {% endif %}
                                            </span>
                                          </div>
                                        {% endif %}

                                    </div>

                                  {% endif %}

                                    <h3 class="card-title {{ settings.card_text_size }}">
                                      <a href="{{ item.url }}" class="text-decoration-none">{{ item.title }}</a>
                                    </h3>

                                    {% if section.settings.show_excerpts %}
                                      <div class="article-description">
                                        {{ item.excerpt_or_content | strip_html | truncatewords: 15 }}
                                      </div>
                                    {% endif %}

                                    {% if section.settings.readmore_button %}
                                      <div class="read_more">
                                        <a href="{{ item.url }}">{{ 'sections.blogs.article.read_more' | t }}</a>
                                      </div>
                                    {% endif %}
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% elsif item.object_type == 'page' %}
                          <div class="pages d-block ratio ratio-3x4 mb-3 {% if card_alignment == 'normal' and settings.card_align == 'card' %}h-100{% endif %}">
                            <a href="{{ item.url }}" class="d-flex justify-content-center align-items-center overflow-y-auto text-decoration-none h2 text-break text-center">
                              <span>{{ item.title }}</span>
                            </a>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                  {% comment %} {%- endif -%} {% endcomment %}
                {%- endfor -%}

               {%- if paginate.parts.size > 1 -%}
                  <input type="hidden" id="paginate_totalcount" class="visually-hidden" value="{{ paginate.items }}"  aria-label="{{ paginate.items }}" >
                  <div class="pagination-container mt-3 mt-xl-5 text-center w-100 d-none">
                    <div class="pagination justify-content-center align-items-center flex-wrap">
                      {{ paginate | default_pagination: next: next_html, previous: prev_html }}
                    </div>
                  </div>
                {%- endif -%}
                {% render 'pagination', paginate: paginate %}
              {%- endpaginate -%}

            {% else %}
              {% if collection.products.size == 0 %}
                <div class="no-results h5 col my-4 text-center">No products found. Please adjust your filters</div>
              {% endif %}
              {%- paginate collection.products by post_limit -%}
                {%- for product in collection.products -%}
                  {%- assign index = forloop.index -%}

                  {% comment %} this condition index of value value get  {% endcomment %}

                  {% if desktop_columns == 2 %}
                    {%- assign is_even = index | modulo: 2 -%}
                  {% elsif desktop_columns == 4 %}
                    {%- assign is_even = index | modulo: 2 -%}
                    {%- assign even = index | modulo: 3 -%}
                  {% elsif desktop_columns == 3 %}
                    {%- assign is_even = index | modulo: 3 -%}
                  {% endif %}

                  {% comment %} this condition gat value apply in number of column {% endcomment %}

                  {%- capture margin_top -%}
                    {%- if desktop_columns == 2 -%}
                        {%- if is_even == 1 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                    {%- elsif desktop_columns == 4 -%}
                        {%- if is_even == 1 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                        {% if even == 2 and card_alignment == 'stepped' %} even{%- endif -%}
                      {%- elsif desktop_columns == 3 -%}
                        {%- if is_even == 2 and card_alignment == 'stepped' -%}sm-mt-14{%- endif -%}
                      {%- endif -%}
                  {%- endcapture -%}

                  {%- capture col_width -%}
                    {%- if card_alignment == 'normal' -%}
                          col-12
                        {%- elsif column and card_alignment == 'stepped' -%}
                          col-12 col-md-11
                        {%- endif -%}
                  {%- endcapture -%}

                  <div class="product-card {{ margin_top }}">
                    <div class="row{% if card_alignment == "normal" and settings.card_align == "card" %} h-100{% endif %}">
                      <div class="main-card {{ col_width }}">
                        {% render 'card-product',
                          aspect_ratio: aspect_ratio,
                          card_product: product,
                          desktop_layout: desktop_layout,
                          show_filter: show_filter,
                          filter: filter,
                          layout: four_column,
                          secondary_img: section.settings.secondary_img,
                          show_inventory: section.settings.show_inventory,
                          show_vendor: section.settings.show_vendor,
                          show_swatches: section.settings.show_swatches,
                          enable_quickview: section.settings.enable_quickview,
                          enable_add_to_cart: section.settings.enable_add_to_cart,
                          show_product_type: section.settings.show_product_type,
                          section_id: section.id
                        %}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
                {%- if paginate.parts.size > 1 -%}
                    <input type="hidden" id="paginate_totalcount" class="visually-hidden" value="{{ paginate.items }}"  aria-label="{{ paginate.items }}"  />
                    <div class="pagination-container mt-3 mt-xl-5 text-center w-100 d-none">
                      <div class="pagination justify-content-center align-items-center flex-wrap"> {{ paginate | default_pagination: next: next_html, previous: prev_html }} </div>
                    </div>
                  {%- endif %}
                {% render 'pagination', paginate: paginate %}
              {%- endpaginate %}
            {% endif %}
          </div>

          {% if view_more %}
            <button id="load-more" class="btn btn-primary mt-5 d-block mx-auto">
              {{ 'sections.main-colletion.view-more' | t }}
            </button>
            {% assign load_type = 'load_more' %}

          {% else %}
            {% assign load_type = 'auto_scroll' %}
            <button id="load-more" class="btn btn-primary mt-4" style="display:none !important;">
              {{ 'sections.main-colletion.view-more' | t }}
            </button>
          {% endif %}
        </div>

        <!-- end main-products -->
      </div>
    {% else %}
      <div class="w-100 empty_collection d-grid text-center justify-content-center gap-4">
        <div>{% render 'no-result' %}</div>
        <h4 class="h2 text-center">{{ 'sections.main-colletion.no-result' | t }}</h4>
      </div>
    {% endif %}
  </div>
</div>

<!-- Drawer -->

{% if filter_style == 'drawer' or filter_style == 'sidebar' %}
  <div
    class="mobile_card_drawer offcanvas offcanvas-end color-{{ settings.canvas_color_scheme }} yes"
    data-bs-scroll="false"
    tabindex="-1"
    id="filterOffCanvas"
    aria-labelledby="filterDrawer"
  >
