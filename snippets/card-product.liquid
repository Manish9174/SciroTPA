{% liquid
  # Determine the aspect ratio for the product card

  # check 3D ar ratio
  if card_product.featured_media.media_type == 'model'
    assign ar_ratio = 1
  endif
%}

{% style %}
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
    /* Popup code ends */

    .card-image .swiper-slide{
      background:rgb(var(--color-background));
    }

     .main-product .product__details .variants ul[data-option-name="color"] li.option-item.btn.available.highlighted1.none_color {
             background: rgb(var(--color-input-bg));
              color: rgb(var(--color-input-text-color));
             }

   .main-product .product__details .variants ul[data-option-name="color"] li.option-item.swatch[data-id="{{ variant.id }}"]{
              {%  if swatch_image %} background:url('{{ swatch_image |  image_url: width: 100 }}'); {% endif %}
                background-size: cover;
                background-repeat: no-repeat;
                background-position: center;
                background-color: {{ swatch_color }};
   }


  .image_wrapper img{
    /* content-visibility: auto; */
    background: rgba(var(--color-background));
  }

   {% if settings.card_align == "standard" %}
      /* .card .card .card-body{ padding-bottom:0 !important;} */
     {% endif %}
