      <!doctype html>
      <html class="no-js" lang="{{ request.locale.iso_code }}">
      <head>
      <meta charset="utf-8">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="theme-color" content="">
      <link rel="canonical" href="{{ canonical_url }}">
      <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

      {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      {% endif %}
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}

    <script src="{{ 'jquery.min.js' | asset_url }}"></script>
    <script src="{{ 'popper.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'bootstrap.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>
    <script src="{{ 'header-search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'main_core.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'main_section.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'main-highvariant.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'mini-cart.js' | asset_url }}" defer="defer"></script>
      <title>{{ shop.name }}</title>

      {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
      {% endif %}

      {% render 'meta-tags' %}
      {{ content_for_header }}
      {{ 'theme.css' | asset_url | stylesheet_tag }}
      {{ 'style.css' | asset_url | stylesheet_tag }}

      <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
      document.documentElement.classList.add('shopify-design-mode');
      }
      </script>

      {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      %}
      {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {% for scheme in settings.color_schemes -%}
      {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
      {% if forloop.index == 1 -%}
      :root,
      {%- endif %}
      .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      {% if scheme.settings.background_gradient != blank %}
      --gradient-background: {{ scheme.settings.background_gradient }};
      {% else %}
      --gradient-background: {{ scheme.settings.background }};
      {% endif %}
      {% liquid
      assign background_color = scheme.settings.background
      assign background_color_brightness = background_color | color_brightness
      if background_color_brightness <= 26
      assign background_color_contrast = background_color | color_lighten: 50
      elsif background_color_brightness <= 65
      assign background_color_contrast = background_color | color_lighten: 5
      else
      assign background_color_contrast = background_color | color_darken: 25
      endif
      %}

      --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-bg-hex: {{ scheme.settings.background }};
      --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
      --color-heading: {{ scheme.settings.color_heading.red }},{{ scheme.settings.color_heading.green }},{{ scheme.settings.color_heading.blue }};
      --color-primary-button-bg: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
      --color-primary-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
      --color-primary-button-border:{{ scheme.settings.button_border.red }},{{ scheme.settings.button_border.green }},{{ scheme.settings.button_border.blue }};
      --color-secondary-button-bg: {{ scheme.settings.secondary_button.red }},{{ scheme.settings.secondary_button.green }},{{ scheme.settings.secondary_button.blue }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
      --color-secondary-button-border:{{ scheme.settings.secondary_border.red }},{{ scheme.settings.secondary_border.green }},{{ scheme.settings.secondary_border.blue }};
      --color-link: {{ scheme.settings.link_color.red }},{{ scheme.settings.link_color.green }},{{ scheme.settings.link_color.blue }};
      --color-input-background: {{ scheme.settings.bg_input.red }},{{ scheme.settings.bg_input.green }},{{ scheme.settings.bg_input.blue }};
      --color-border: {{ scheme.settings.color_border.red }},{{ scheme.settings.color_border.green }},{{ scheme.settings.color_border.blue }};
      --color-input-border: {{ scheme.settings.color_input.red }},{{ scheme.settings.color_input.green }},{{ scheme.settings.color_input.blue }};
      --color-input-bg: {{ scheme.settings.color_input.red }},{{ scheme.settings.color_input.green }},{{ scheme.settings.color_input.blue }};
      --color-input-text-color: {{ scheme.settings.input_text.red }},{{ scheme.settings.input_text.green }},{{ scheme.settings.input_text.blue }};
      --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      --bs-link-color-rgb: var(--color-link);
      --bs-link-hover-color-rgb:var(--color-link);
      --bs-bg-input:rgb(var(--color-input-background));
      --bs-border-color: rgb(var(--color-input-text-color));
      --swiper-pagination-color:rgb(var(--color-primary-button-bg));
      --bs-navbar-color: rgba(var(--color-foreground), 1);
      --bs-navbar-active-color:rgba(var(--color-link),1);
      --border-color:rgba(var(--color-input-border),{{ settings.input_border_opacity | times:0.01 }})
      }

      {%  if background_color_brightness <= 35 %}
      .password-page.color-{{ scheme.id }} .btn-close {
      filter: var(--bs-btn-close-white-filter);
      }
      {% endif %}

      {% endfor %}
      {{ scheme_classes | prepend: 'body' }} {
      --bs-body-color: rgba(var(--color-foreground), 0.8);
      --bs-body-color-rgb: var(--color-foreground);
      color: rgba(var(--color-foreground), 0.8);
      background-color: rgb(var(--color-background));
      }
      :root {
      --bs-body-bg:var(--color-bg-hex);
      --bs-body-bg-rgb:var(--color-background);
      --bs-body-font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};
      --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};
      --bs-body-line-height:{{ settings.body_line_height }};
      --bs-body-letter-space:{{ settings.body_letter_space }}px;

      --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-heading-style: {{ settings.type_header_font.style }};
      --font-heading-weight: {{ settings.type_header_font.weight }};
      --font-heading-color:var(--color-foreground);
      --heading-line-height:{{ settings.heading_line_height }};
      --heading-letter-space:{{ settings.heading_letter_space }}px;

      --page-width: {{ settings.page_width | divided_by: 1 }}rem;
      --page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;
      --bs-btn-border:{{ settings.btn_border}}px;
      --bs-input-border:{{ settings.input_border}}px;
      --bs-btn-border-opacity:{{ settings.btn_border_opacity | times:0.01}};
      --head-h1:clamp(1.875rem, 1.5rem + 1.875vw, 3.75rem);
      --head-h2:clamp(1.5rem, 1.3rem + 1vw, 2.5rem);
      --head-h3:clamp(1.375rem, 1.2rem + 0.875vw, 2.25rem);
      --head-h4:clamp(1.25rem, 1.125rem + 0.625vw, 1.875rem);
      --head-h5:clamp(1.125rem, 1.05rem + 0.375vw, 1.5rem);
      --head-h6:clamp(1rem, 0.95rem + 0.25vw, 1.25rem);
      --bg-white: #fff;
      --head-font-scale:{{ settings.header_size | times:0.01 }};
      --body-font-scale:{{ settings.base_font_size | times:0.01 }};
      --h1:calc(var(--head-h1) * var(--head-font-scale));
      --h2:calc(var(--head-h2) * var(--head-font-scale));
      --h3:calc(var(--head-h3) * var(--head-font-scale));
      --h4:calc(var(--head-h4) * var(--head-font-scale));
      --h5:calc(var(--head-h5) * var(--head-font-scale));
      --h6:calc(var(--head-h6) * var(--head-font-scale));

       --email-btn-width: 0px;
      {% if settings.input_radius == "small" %}
      --input-btn-border-radius:.25rem;
      {% elsif settings.input_radius == "medium" %}
      --input-btn-border-radius:.5rem;
      {% elsif settings.input_radius == "large" %}
      --input-btn-border-radius:40px;
      {% elsif settings.input_radius == "none" %}
      --input-btn-border-radius:0rem;
      {% endif %}

      {% if settings.btn_radius == "small" %}
      --btn-border-radius:.25rem !important;
      {% elsif settings.btn_radius == "medium" %}
      --btn-border-radius:.5rem !important;
      {% elsif settings.btn_radius == "large" %}
      --btn-border-radius:5rem !important;
      {% elsif settings.btn_radius == "none" %}
      --btn-border-radius:0rem !important;
      {% endif %}


      }
      .gradient {
      background: rgb(var(--color-background));
      background: var(--gradient-background);
      background-attachment: fixed;
      }
      h6, .h6, h5, .h5, h4, .h4, h3, .h3, h2, .h2, h1, .h1{
      --bs-heading-color:rgba(var(--color-heading),var(--wdt-text-opacity));
      --wdt-text-opacity: 1;
      font-family: var(--font-heading-family);
      text-transform: uppercase;
      }
      .form-control{
      border-radius: var(--input-btn-border-radius) !important;
      }

      @media (min-width: 992px) {
      [id$="OffCanvas"],[class$="OffCanvas"] {
      {% if settings.canvas_style == "default" %}
      clip-path: circle(clamp(1040px,50vw,50vw) at calc(100% - clamp(0px,(1920px - 100vw),0px)) 50%);
      {% elsif settings.canvas_style == "zigzag" %}
      clip-path: polygon(100% 0%, 0% 0%, 10% 12.25%, 0% 25%, 10% 37.25%, 0% 50%, 10% 62.25%, 0% 75%, 10% 87.25%, 0% 100%, 100% 100%);
      {% else %}
      clip-path: none;
      {% endif %}
      }
      }
      {% if settings.card_alignment == "normal" %}
      .card_container .card_wrapper:nth-child(3n+2), .main_collection .product-card:nth-child(odd), .main_blog .article-card:nth-child(even), .md-mt-14, .card_container .card_wrapper:nth-child(even), .featured_blog .article-card:nth-child(even)
      {
      margin-top:0 !important;
      }
      {% endif %}
      .password_error li{
      list-style:none;
      }
      .card_product_detail{
      border: {{ settings.border }}px solid rgba(var(--color-foreground));
      border-radius:{{ settings.card_radius }}px;
      overflow:hidden;
      }
      .blog-article{
      border: {{ settings.blog_border }}px solid rgba(var(--color-foreground));
      border-radius:{{ settings.blog_card_radius }}px;
      overflow:hidden;
      }
      {% endstyle %}
      </head>

      <body class="password gradient">
      <div class='wrapper'>
      <div class="inner-wrapper">
      <div class="password-page page-width text-center" role="main">
      <div class="password-page__inner">
      <div class="password-page__content">

      {{ content_for_layout }}
      </div>
      </div>
      </div>
      <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
      </ul>
      </div>
      </div>

    <script>

function email__button() {
  document.querySelectorAll(".form_input").forEach((group) => {
    const btn = group.querySelector(".input_button");
    if (!btn) return;

    group.style.setProperty(
      "--email-btn-width",
      btn.offsetWidth + "px"
    );
  });
}

window.addEventListener("load", email__button);
window.addEventListener("resize", email__button);
document.addEventListener("shopify:section:load", email__button);


    </script>
      </body>
      </html>
