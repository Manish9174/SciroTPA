  </head>

  <body class="gradient">
    <a
      class="skip-to-content-link btn btn-primary visually-hidden btn position-absolute start-0 w-auto py-2 px-3 m-2"
      href="#MainContent"
    >
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    {%- render 'cart-drawer' -%}
    {%- render 'search-drawer' -%}
    {%- render 'modal_quickview' -%}
    <div class="wrapper">
      <div class="inner-wrapper">
        {% sections 'header-group' %}
        <main id="MainContent" class="content-for-layout shadow-none outline-none" role="main" tabindex="-1">
          {{ content_for_layout }}
        </main>
        {% sections 'footer-group' %}
      </div>
    </div>

    <script>
        /* Overlay Tab comtrol */
        var main = document.getElementById('MainContent');

      function focusMain() {
        if (main) {
          if (!main.hasAttribute('tabindex')) {
            main.setAttribute('tabindex', '-1');
          }
          main.focus();
        }
      }

      document.addEventListener('click', function(event) {
        var target = event.target;
        if (!target.closest) return;

        if (target.closest('[data-newsletter-popup-close]')) {
          focusMain();
        }
      });

      document.addEventListener('keyup', function(event) {
        if (event.key === 'Escape') {
          var popup = document.querySelector('[data-newsletter-popup]');
          if (popup && !popup.hasAttribute('hidden')) {
            focusMain();
          }
        }
      });

        {% if settings.animation != 'none' %}
        AOS.init({
            once: true,
            offset: 50,
            delay: 0,
            duration: 1000,
            initClassName: 'aos-init',
            animatedClassName: 'aos-animate',
        });  {% endif %}
        $(document).ready(function () {
          function checkHashAndToggle() {
            if (window.location.hash === '#recover') {
              $('#reset_password').show();
              $('#login_panel').hide();
            } else {
              $('#reset_password').hide();
              $('#login_panel').show();
            }
          }
          checkHashAndToggle();

          $(window).on('hashchange', function () {
            checkHashAndToggle();
          });

          $('#header_searchresult').hide();

          $('#header_search').click(function () {
            setTimeout(function () {
              $('input#Search').focus();
            }, 500);
            $('#header_searchresult').slideToggle();
            $('#header_searchresult').attr('style', 'width:1000px;height:200px; border:2px solid #ccc;');
          });
          $('.search_clear_btn').click(function (e) {
            e.preventDefault();
            if ($('input#Search').length) {
              $('input#Search').val('');
              $(this).addClass('d-none');
              $('.filter_top_bar').addClass('d-none');
            }
            if ($('input#SearchFormSearch').length) {
              $('input#SearchFormSearch').val('');
               $(this).addClass('d-none');

            }
            $('.predictive-search-empty').addClass('d-none');
              $('.frequent_search').removeAttr('style');
              $('.search_collection').removeAttr('style');
               $('#predictive-search-results').addClass('d-none');
          });
          $('#SearchFormSearch').keyup(function (e) {
              var SearchFormSearchLen = $(this).val().length;
              if(SearchFormSearchLen == "0") { $('.search_clear_btn').addClass('d-none') }
              else {  $('.search_clear_btn').removeClass('d-none') }

          });

          $('.edit_address,.address_details').hide();
          $('.editaddress_button').click(function () {
            $(this).siblings('.edit_address').toggle();
          });
           $('.addnew_address').click(function () {
            $('.address_details').removeClass('d-none');
            $('.address_details').toggle();
          });

          $('.search-container').hide();
          $('.toggle_filter').click(function () {
            $('.search-container').toggle();
          });
        });
    </script>
    {% render 'common-variables' %}
    {% sections 'overlay-group' %}
  </body>
</html>
