           border-radius:var(--bs-radius);
           overflow:hidden;
           }
           .collection_cards{
           border: var(--bs-style-border) solid var(--bs-border-color);
           border-radius:var(--bs-radius);
           overflow:hidden;
           }
           /*common border and radius*/
           {% if settings.card_align == 'standard'%}
           .produc_card .card-img:has(a:focus-visible){
           outline: 2px dashed currentcolor !important;
           }
           .produc_card .card-image:has(a:focus-visible){
