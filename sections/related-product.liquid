      "visible_if": "{{ section.settings.layout_style == 'grid' }}"
    },
    {
      "type": "select",
      "id": "desktop_grid_view",
      "options": [
        {
          "value": "3",
          "label": "t:sections.product-slider.settings.column_option.desktop.options__1.label"
        },
        {
          "value": "4",
          "label": "t:sections.product-slider.settings.column_option.desktop.options__2.label"
        },
        {
          "value": "5",
          "label": "t:sections.product-slider.settings.column_option.desktop.options__3.label"
