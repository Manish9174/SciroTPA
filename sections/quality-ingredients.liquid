<section
  class="quality-ingredients"
  data-quality-ingredients
  data-section-id="{{ section.id }}"
>
  <div class="quality-ingredients__container">

    {% comment %} HEADER {% endcomment %}
    <div class="quality-ingredients__header {{ section.settings.alignment }}">

      {% if section.settings.eyebrow != blank %}
        <p class="quality-ingredients__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="quality-ingredients__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="quality-ingredients__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="quality-ingredients__buttons">
          <a
            class="quality-ingredients__button"
            href="{{ section.settings.button_link | default: '#' }}"
          >
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}

    </div>


    {% comment %} SLIDER {% endcomment %}
    {% if section.blocks.size > 0 %}

      <div class="quality-ingredients__slider-wrap">

        {% if section.settings.show_arrows %}
          <button
            class="quality-ingredients__arrow quality-ingredients__arrow--prev"
            type="button"
            aria-label="Previous ingredient"
          >
            <span aria-hidden="true">←</span>
          </button>
        {% endif %}


        <div
          class="quality-ingredients__slider"
          data-slider
          tabindex="0"
        >

          <div class="quality-ingredients__track">

            {% for block in section.blocks %}

              <article
                class="quality-ingredients__slide"
                data-slide
                {{ block.shopify_attributes }}
              >

                <div class="quality-ingredients__card">

                  {% if block.settings.image != blank %}

                    {{
                      block.settings.image
                      | image_url: width: 1800
                      | image_tag:
                        class: 'quality-ingredients__image',
                        widths: '400,600,800,1000,1200,1600,1800',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 48vw, 88vw',
                        loading: 'lazy',
                        alt: block.settings.image.alt | default: block.settings.title | escape
                    }}

                  {% else %}

                    {{ 'image' | placeholder_svg_tag: 'quality-ingredients__placeholder' }}

                  {% endif %}


                  {% comment %}
                    GLASS / BLUR CONTENT
                  {% endcomment %}

                  <div class="quality-ingredients__glass">

                    {% if block.settings.label != blank %}
                      <div class="quality-ingredients__label">
                        {{ block.settings.label }}
                      </div>
                    {% endif %}

                    {% if block.settings.title != blank %}
                      <h3 class="quality-ingredients__title">
                        {{ block.settings.title }}
                      </h3>
                    {% endif %}

                    {% if block.settings.description != blank %}
                      <div class="quality-ingredients__card-description">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    {% if block.settings.link_label != blank %}

                      <a
                        class="quality-ingredients__card-link"
                        href="{{ block.settings.link | default: '#' }}"
                      >
                        {{ block.settings.link_label }}
                        <span aria-hidden="true">→</span>
                      </a>

                    {% endif %}

                  </div>

                </div>

              </article>

            {% endfor %}

          </div>

        </div>


        {% if section.settings.show_arrows %}

          <button
            class="quality-ingredients__arrow quality-ingredients__arrow--next"
            type="button"
            aria-label="Next ingredient"
          >
            <span aria-hidden="true">→</span>
          </button>

        {% endif %}

      </div>


      {% if section.settings.show_dots and section.blocks.size > 1 %}

        <div
          class="quality-ingredients__dots"
          data-dots
          aria-label="Ingredient slider navigation"
        >

          {% for block in section.blocks %}

            <button
              type="button"
              class="quality-ingredients__dot{% if forloop.first %} is-active{% endif %}"
              data-dot="{{ forloop.index0 }}"
              aria-label="Go to ingredient {{ forloop.index }}"
            ></button>

          {% endfor %}

        </div>

      {% endif %}

    {% endif %}

  </div>
</section>


<style>

  /* =========================================================
     MAIN SECTION
  ========================================================= */

  .quality-ingredients {
    --qi-bg: {{ section.settings.background_color }};
    --qi-text: {{ section.settings.text_color }};
    --qi-card-text: {{ section.settings.card_text_color }};

    --qi-gap: {{ section.settings.card_gap }}px;
    --qi-radius: {{ section.settings.card_radius }}px;

    --qi-card-height: {{ section.settings.card_height }}px;

    --qi-glass-blur: {{ section.settings.glass_blur }}px;
    --qi-glass-opacity: {{ section.settings.glass_opacity | divided_by: 100.0 }};
    --qi-glass-height: {{ section.settings.glass_height }}%;

    --qi-heading-size: {{ section.settings.heading_size }}px;
    --qi-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;

    --qi-top: {{ section.settings.padding_top }}px;
    --qi-bottom: {{ section.settings.padding_bottom }}px;

    width: 100%;
    background: var(--qi-bg);
    color: var(--qi-text);

    padding-top: var(--qi-top);
    padding-bottom: var(--qi-bottom);

    overflow: hidden;
  }


  /* =========================================================
     CONTAINER
  ========================================================= */

  .quality-ingredients__container {
    width: 100%;
    max-width: 1500px;

    margin: 0 auto;

    padding-left: 24px;
    padding-right: 24px;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .quality-ingredients__header {
    margin-bottom: 50px;
  }

  .quality-ingredients__header.left {
    text-align: left;
  }

  .quality-ingredients__header.center {
    text-align: center;
  }

  .quality-ingredients__header.right {
    text-align: right;
  }


  .quality-ingredients__eyebrow {
    margin: 0 0 12px;

    font-size: 12px;
    line-height: 1.3;

    letter-spacing: 0.14em;
    text-transform: uppercase;

    opacity: 0.75;
  }


  .quality-ingredients__heading {
    margin: 0;

    color: var(--qi-text);

    font-size: var(--qi-heading-size);
    line-height: 1.05;

    letter-spacing: -0.035em;

    font-weight: 500;
  }


  .quality-ingredients__description {
    max-width: 850px;

    margin-top: 18px;

    font-size: 16px;
    line-height: 1.55;
  }


  .quality-ingredients__description p {
    margin: 0;
  }


  .quality-ingredients__header.center
  .quality-ingredients__description {
    margin-left: auto;
    margin-right: auto;
  }


  .quality-ingredients__header.right
  .quality-ingredients__description {
    margin-left: auto;
  }


  /* =========================================================
     BUTTON
  ========================================================= */

  .quality-ingredients__buttons {
    display: flex;

    margin-top: 26px;
  }


  .quality-ingredients__header.center
  .quality-ingredients__buttons {
    justify-content: center;
  }


  .quality-ingredients__header.right
  .quality-ingredients__buttons {
    justify-content: flex-end;
  }


  .quality-ingredients__button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 46px;

    padding: 13px 24px;

    border-radius: 999px;

    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};

    text-decoration: none;

    font-size: 14px;
    line-height: 1;

    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }


  .quality-ingredients__button:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }


  /* =========================================================
     SLIDER
  ========================================================= */

  .quality-ingredients__slider-wrap {
    position: relative;

    width: 100%;
  }


  .quality-ingredients__slider {
    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    scrollbar-width: none;

    scroll-behavior: smooth;

    scroll-snap-type: x mandatory;

    overscroll-behavior-x: contain;

    -webkit-overflow-scrolling: touch;
  }


  .quality-ingredients__slider::-webkit-scrollbar {
    display: none;
  }


  .quality-ingredients__track {
    display: flex;

    gap: var(--qi-gap);
  }


  .quality-ingredients__slide {
    flex: 0 0 calc(
      (
        100% -
        (
          {{ section.settings.desktop_columns | minus: 1 }}
          * var(--qi-gap)
        )
      )
      /
      {{ section.settings.desktop_columns }}
    );

    min-width: 0;

    scroll-snap-align: start;
  }


  /* =========================================================
     CARD
  ========================================================= */

  .quality-ingredients__card {
    position: relative;

    width: 100%;

    height: var(--qi-card-height);

    overflow: hidden;

    border-radius: var(--qi-radius);

    background: #d8d8d8;
  }


  /* =========================================================
     IMAGE
  ========================================================= */

  .quality-ingredients__image,
  .quality-ingredients__placeholder {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: {{ section.settings.image_fit }};

    object-position: {{ section.settings.image_position }};

    transition:
      transform 0.5s cubic-bezier(.2,.7,.2,1);
  }


  .quality-ingredients__placeholder {
    width: 100%;
    height: 100%;
  }


  .quality-ingredients__card:hover
  .quality-ingredients__image {
    transform: scale(1.045);
  }


  /* =========================================================
     GLASS PANEL
  ========================================================= */

  .quality-ingredients__glass {
    position: absolute;

    z-index: 3;

    left: 0;
    right: 0;
    bottom: 0;

    min-height: var(--qi-glass-height);

    padding: 30px;

    display: flex;

    flex-direction: column;

    justify-content: flex-end;

    color: var(--qi-card-text);

    background:
      rgba(
        0,
        0,
        0,
        var(--qi-glass-opacity)
      );

    /*
      ACTUAL GLASS / BLUR EFFECT
      The image above remains sharp.
      Only the area behind this panel is blurred.
    */

    -webkit-backdrop-filter:
      blur(var(--qi-glass-blur))
      saturate(115%);

    backdrop-filter:
      blur(var(--qi-glass-blur))
      saturate(115%);

    border-top:
      1px solid rgba(255,255,255,0.12);

    isolation: isolate;
  }


  /* Soft transition from sharp image to glass */

  .quality-ingredients__glass::before {
    content: "";

    position: absolute;

    left: 0;
    right: 0;

    bottom: 100%;

    height: {{ section.settings.glass_fade }}px;

    background:
      linear-gradient(
        to bottom,
        rgba(0,0,0,0),
        rgba(0,0,0,var(--qi-glass-opacity))
      );

    pointer-events: none;

    z-index: -1;
  }


  /* =========================================================
     CARD CONTENT
  ========================================================= */

  .quality-ingredients__label {
    margin-bottom: 8px;

    font-size: 11px;
    line-height: 1.3;

    letter-spacing: 0.13em;

    text-transform: uppercase;

    opacity: 0.78;
  }


  .quality-ingredients__title {
    margin: 0;

    color: inherit;

    font-size: 28px;
    line-height: 1.1;

    letter-spacing: -0.025em;

    font-weight: 500;
  }


  .quality-ingredients__card-description {
    margin-top: 10px;

    font-size: 14px;
    line-height: 1.5;

    opacity: 0.9;
  }


  .quality-ingredients__card-description p {
    margin: 0;
  }


  .quality-ingredients__card-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    width: fit-content;

    margin-top: 18px;

    color: inherit;

    text-decoration: none;

    font-size: 13px;

    font-weight: 500;

    transition:
      gap 0.25s ease,
      opacity 0.25s ease;
  }


  .quality-ingredients__card-link:hover {
    gap: 12px;
    opacity: 0.8;
  }


  /* =========================================================
     ARROWS
  ========================================================= */

  .quality-ingredients__arrow {
    position: absolute;

    z-index: 10;

    top: 50%;

    transform: translateY(-50%);

    width: 48px;
    height: 48px;

    padding: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: {{ section.settings.arrow_background }};

    color: {{ section.settings.arrow_color }};

    cursor: pointer;

    box-shadow:
      0 8px 25px rgba(0,0,0,0.15);

    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }


  .quality-ingredients__arrow:hover {
    transform:
      translateY(-50%)
      scale(1.08);
  }


  .quality-ingredients__arrow--prev {
    left: -20px;
  }


  .quality-ingredients__arrow--next {
    right: -20px;
  }


  .quality-ingredients__arrow span {
    font-size: 20px;

    line-height: 1;
  }


  /* =========================================================
     DOTS
  ========================================================= */

  .quality-ingredients__dots {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 7px;

    margin-top: 25px;
  }


  .quality-ingredients__dot {
    width: 7px;
    height: 7px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    background: {{ section.settings.dot_color }};

    opacity: 0.35;

    cursor: pointer;

    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }


  .quality-ingredients__dot.is-active {
    opacity: 1;

    transform: scale(1.35);
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 989px) {

    .quality-ingredients {
      --qi-card-height:
        calc(var(--qi-card-height) * 0.9);
    }


    .quality-ingredients__slide {
      flex-basis: calc(
        (
          100% -
          (
            {{ section.settings.tablet_columns | minus: 1 }}
            * var(--qi-gap)
          )
        )
        /
        {{ section.settings.tablet_columns }}
      );
    }


    .quality-ingredients__heading {
      font-size:
        calc(var(--qi-heading-size) * 0.88);
    }


    .quality-ingredients__glass {
      padding: 24px;
    }


    .quality-ingredients__title {
      font-size: 24px;
    }


    .quality-ingredients__arrow--prev {
      left: 10px;
    }


    .quality-ingredients__arrow--next {
      right: 10px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    .quality-ingredients {
      padding-top:
        calc(var(--qi-top) * 0.72);

      padding-bottom:
        calc(var(--qi-bottom) * 0.72);
    }


    .quality-ingredients__container {
      padding-left: 16px;
      padding-right: 16px;
    }


    .quality-ingredients__header {
      margin-bottom: 30px;
    }


    .quality-ingredients__eyebrow {
      font-size: 10px;

      margin-bottom: 9px;
    }


    .quality-ingredients__heading {
      font-size: var(--qi-mobile-heading-size);

      line-height: 1.08;
    }


    .quality-ingredients__description {
      margin-top: 14px;

      font-size: 14px;

      line-height: 1.5;
    }


    .quality-ingredients__buttons {
      margin-top: 20px;
    }


    .quality-ingredients__button {
      min-height: 42px;

      padding: 11px 19px;

      font-size: 13px;
    }


    .quality-ingredients__track {
      gap: 12px;
    }


    .quality-ingredients__slide {
      flex: 0 0 {{ section.settings.mobile_slide_width }}%;
    }


    .quality-ingredients__card {
      height: 500px;

      border-radius:
        calc(var(--qi-radius) * 0.85);
    }


    .quality-ingredients__glass {
      min-height: 52%;

      padding: 22px;
    }


    .quality-ingredients__title {
      font-size: 23px;
    }


    .quality-ingredients__card-description {
      font-size: 13px;
    }


    .quality-ingredients__card-link {
      margin-top: 14px;
    }


    .quality-ingredients__arrow {
      width: 40px;
      height: 40px;
    }


    .quality-ingredients__arrow--prev {
      left: 6px;
    }


    .quality-ingredients__arrow--next {
      right: 6px;
    }


    .quality-ingredients__arrow span {
      font-size: 17px;
    }


    .quality-ingredients__dots {
      margin-top: 20px;
    }

  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .quality-ingredients__slider {
      scroll-behavior: auto;
    }

    .quality-ingredients__image {
      transition: none;
    }

    .quality-ingredients__button,
    .quality-ingredients__arrow,
    .quality-ingredients__card-link {
      transition: none;
    }

  }

</style>


<script>

  (function () {

    function initQualityIngredients(root) {

      if (!root) return;

      if (root.dataset.qiInitialized === "true") {
        return;
      }

      root.dataset.qiInitialized = "true";


      var slider =
        root.querySelector("[data-slider]");

      var track =
        root.querySelector(".quality-ingredients__track");

      var slides =
        Array.prototype.slice.call(
          root.querySelectorAll("[data-slide]")
        );

      var prev =
        root.querySelector(
          ".quality-ingredients__arrow--prev"
        );

      var next =
        root.querySelector(
          ".quality-ingredients__arrow--next"
        );

      var dots =
        Array.prototype.slice.call(
          root.querySelectorAll("[data-dot]")
        );


      if (!slider || !track || slides.length === 0) {
        return;
      }


      var autoplay =
        {{ section.settings.enable_autoplay | json }};

      var pauseOnHover =
        {{ section.settings.pause_on_hover | json }};

      var interval =
        {{ section.settings.autoplay_speed | times: 1000 }};


      var timer = null;

      var currentIndex = 0;


      /* =====================================================
         GET SLIDE POSITION
      ===================================================== */

      function getSlideWidth() {

        if (!slides[0]) {
          return slider.clientWidth;
        }

        return (
          slides[0].getBoundingClientRect().width
          +
          parseFloat(
            getComputedStyle(track).gap || 0
          )
        );

      }


      /* =====================================================
         UPDATE DOTS
      ===================================================== */

      function updateDots(index) {

        dots.forEach(function (dot, i) {

          if (i === index) {

            dot.classList.add("is-active");

            dot.setAttribute(
              "aria-current",
              "true"
            );

          } else {

            dot.classList.remove("is-active");

            dot.removeAttribute(
              "aria-current"
            );

          }

        });

      }


      /* =====================================================
         GO TO SLIDE
      ===================================================== */

      function goTo(index) {

        if (slides.length <= 1) {
          return;
        }


        if (index < 0) {
          index = slides.length - 1;
        }


        if (index >= slides.length) {
          index = 0;
        }


        currentIndex = index;


        slider.scrollTo({
          left:
            slides[index].offsetLeft,
          behavior: "smooth"
        });


        updateDots(currentIndex);
      }


      /* =====================================================
         NEXT
      ===================================================== */

      function nextSlide() {

        goTo(currentIndex + 1);

      }


      /* =====================================================
         PREVIOUS
      ===================================================== */

      function previousSlide() {

        goTo(currentIndex - 1);

      }


      /* =====================================================
         DETECT CURRENT SLIDE ON SCROLL
      ===================================================== */

      function updateFromScroll() {

        if (!slides.length) {
          return;
        }


        var scrollLeft =
          slider.scrollLeft;


        var closestIndex = 0;

        var closestDistance = Infinity;


        slides.forEach(function (slide, index) {

          var distance =
            Math.abs(
              slide.offsetLeft - scrollLeft
            );


          if (distance < closestDistance) {

            closestDistance = distance;

            closestIndex = index;

          }

        });


        currentIndex =
          closestIndex;

        updateDots(currentIndex);

      }


      /* =====================================================
         AUTOPLAY
      ===================================================== */

      function stopAutoplay() {

        if (timer) {

          clearInterval(timer);

          timer = null;

        }

      }


      function startAutoplay() {

        stopAutoplay();


        if (
          autoplay &&
          slides.length > 1
        ) {

          timer =
            setInterval(
              nextSlide,
              interval
            );

        }

      }


      /* =====================================================
         BUTTON EVENTS
      ===================================================== */

      if (prev) {

        prev.addEventListener(
          "click",
          function () {

            previousSlide();

            startAutoplay();

          }
        );

      }


      if (next) {

        next.addEventListener(
          "click",
          function () {

            nextSlide();

            startAutoplay();

          }
        );

      }


      /* =====================================================
         DOT EVENTS
      ===================================================== */

      dots.forEach(function (dot) {

        dot.addEventListener(
          "click",
          function () {

            var index =
              parseInt(
                dot.getAttribute("data-dot"),
                10
              );


            goTo(index);

            startAutoplay();

          }
        );

      });


      /* =====================================================
         SCROLL EVENT
      ===================================================== */

      var scrollTimeout;


      slider.addEventListener(
        "scroll",
        function () {

          window.cancelAnimationFrame(
            scrollTimeout
          );


          scrollTimeout =
            window.requestAnimationFrame(
              updateFromScroll
            );

        },
        {
          passive: true
        }
      );


      /* =====================================================
         KEYBOARD
      ===================================================== */

      slider.addEventListener(
        "keydown",
        function (event) {

          if (
            event.key === "ArrowLeft"
          ) {

            event.preventDefault();

            previousSlide();

            startAutoplay();

          }


          if (
            event.key === "ArrowRight"
          ) {

            event.preventDefault();

            nextSlide();

            startAutoplay();

          }

        }
      );


      /* =====================================================
         HOVER PAUSE
      ===================================================== */

      if (pauseOnHover) {

        root.addEventListener(
          "mouseenter",
          stopAutoplay
        );


        root.addEventListener(
          "mouseleave",
          startAutoplay
        );

      }


      /* =====================================================
         FOCUS PAUSE
      ===================================================== */

      root.addEventListener(
        "focusin",
        stopAutoplay
      );


      root.addEventListener(
        "focusout",
        function (event) {

          if (
            !root.contains(
              event.relatedTarget
            )
          ) {

            startAutoplay();

          }

        }
      );


      /* =====================================================
         TOUCH / SWIPE SUPPORT
         Native horizontal scrolling handles this.
      ===================================================== */


      updateFromScroll();

      startAutoplay();

    }


    /* =======================================================
       INITIALIZE
    ======================================================= */

    function initAll() {

      document
        .querySelectorAll(
          "[data-quality-ingredients]"
        )
        .forEach(
          initQualityIngredients
        );

    }


    if (
      document.readyState === "loading"
    ) {

      document.addEventListener(
        "DOMContentLoaded",
        initAll
      );

    } else {

      initAll();

    }


    /* =======================================================
       SHOPIFY THEME EDITOR
    ======================================================= */

    document.addEventListener(
      "shopify:section:load",
      function (event) {

        var root =
          event.target &&
          event.target.querySelector
            ? event.target.querySelector(
                "[data-quality-ingredients]"
              )
            : null;


        initQualityIngredients(root);

      }
    );


  })();

</script>


{% schema %}

{
  "name": "Quality Ingredients",
  "tag": "section",
  "class": "section-quality-ingredients",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUALITY INGREDIENTS"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality ingredients optimized for impact"
    },

