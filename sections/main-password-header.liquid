<div class="header__logo-container flex-1 my-3">
  <div class="container text-lg-center text-sm-start">
    {% if section.settings.transparent_logo and section.settings.curved_header != true and section.settings.home_headertext == blank and section.settings.transparent_header and template == 'index' %}
       <a href="{% unless template == 'password' %}{{ routes.root_url }} {% else %}#{% endunless %}" class="header-logo d-block" aria-label="{{ shop.name }} - Home">
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: section.settings.transparent_logo.aspect_ratio -%}
        {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
        {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
        {{
           section.settings.transparent_logo
          | image_url: width: 600
          | image_tag:
            class: 'img-fluid',
            widths: widths,
            height: logo_height,
            width: settings.logo_width,
            alt: logo_alt,
            sizes: sizes,
            preload: true
        }}
      </a>
   
    {%- elsif settings.logo != blank -%}
      <a href="{% unless template == 'password' %}{{ routes.root_url }} {% else %}#{% endunless %}" class="header-logo d-block" aria-label="{{ shop.name }} - Home">
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
        {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'img-fluid',
            widths: widths,
            height: logo_height,
            width: settings.logo_width,
            alt: logo_alt,
            sizes: sizes,
            preload: true
        }}
      </a>
    {%- else -%}
      <h2 class="header__logo-title mb-0 text-break {% if section.settings.logo_position =='middle-left' %} text-start {% else %} text-center {% endif %}">
        <a href="{{ routes.root_url }}" class="text-decoration-none" aria-label=" {{ shop.name }}- Home">
          {{ shop.name }}
        </a>
      </h2>
    {%- endif -%}
  </div>
   {% render 'line-decor', decorator: 'default' %}
</div>




{% schema %}
  {
    "name": "t:sections.main-password-header.name",
    "settings": [
      {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
      {
      "type": "select",
      "id": "seperator_style",
      "label": "t:sections.header.settings.seperator_style.label",
      "info": "t:sections.header.settings.seperator_style.info",
      "options": [
        {
          "value": "default",
          "label": "t:sections.header.settings.seperator_style.options__1.label"
        },
        {
          "value": "line",
          "label": "t:sections.header.settings.seperator_style.options__2.label"
        },
      ],
      "default": "default"
    },
    ]
  }
{% endschema %}