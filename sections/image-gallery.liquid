{% endstyle %}

<div class="home_slider home_slider-{{ section.id }} section-{{ section.id }}-padding">
  {% if section.settings.pagination == 'arrow' and section.blocks.size > 1 %}
    <div class="my-carousel__actions d-flex">
      <div class="swiper-prev main-prev home_slider_prev-{{ section.id }} rounded-0 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
        {% render 'arrow-left' %}
      </div>
      <div class="swiper-next main-next home_slider_next-{{ section.id }} rounded-0 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
        {% render 'arrow-right' %}
      </div>
    </div>
  {% endif %}
  <div class="my-carousel position-relative">
    <div class="swiper overflow-visible my-image_gallery__swiper my-image_gallery__swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {% assign image_count = section.blocks.size %}
        {% assign repeat_count = 5 %}
        {% if image_count >= 3 %}
          {% assign repeat_count = 2 %}
        {% endif %}
          {% for r in (1..repeat_count) %}
          {% for block in section.blocks %}
            <div class="swiper-slide px-3 px-md-0" data-id="loop-{{ section.id }}-{{ forloop.index }}"  {{ block.shopify_attributes }}>
              <div class="swiper-card swiper-card--{{ forloop.index }} ratio ratio-custom" tabindex="-1">
                  {%- liquid
                    assign collection = block.settings.collection
                    assign width = 750
                    assign height = width | divided_by: block.settings.slider_mobile_image.aspect_ratio | round
                    assign widths = '320, 380, 450, 520, 650'
                    assign format = 'webp'
                      assign loading = 'eager'
                      assign fetchpriority = 'high'
                  -%}
               {% unless block.settings.slider_mobile_image %}
                    <a href=" {% if block.settings.link != blank  %} {{ block.settings.link }} {% else %}  {{ routes.collections_url }}/{{ collection.handle }} {% endif %}" tabindex="-1">
                        {% if collection.image %}
                    {{
                      collection.image
                      | image_url: width: 1200
                      | preload_tag: as: 'image', fetchpriority: 'high',
                       alt: collection.image.alt
                    }}
                      {{
                        collection
                       | image_url: width: width, height: height
                       | image_tag:
                        alt: collection.image.alt,
                        class: 'img-fluid',
                        loading: loading,
                        fetchpriority: fetchpriority,
                        width: width,
                        format: format,
                        height: height,
                        widths: widths,
                        sizes: '(max-width: 767px) 70vw, 33vw'
                        }}
                        {% elsif collection.products.first.featured_media %}
                        {{
                          collection
                        | image_url: width: 1200
                        | preload_tag: as: 'image', fetchpriority: 'high',
                        alt: collection.alt
                        }}
                      {{
                        collection.products.first.featured_media
                        | image_url: width: width, height: height
                        | image_tag:
                        alt: collection.image.alt,
                        class: 'img-fluid',
                        loading: loading,
                        fetchpriority: fetchpriority,
                        width: width,
                        format: format,
                        height: height,
                        widths: widths,
                        sizes: '(max-width: 767px) 70vw, 33vw'
                      }}
                    {% endif %}
                  </a>
               {% endunless %}
                 {%- if block.settings.slider_mobile_image != blank -%}
                            <a
                    href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                     tabindex="-1"
                  >
                    {{
                      block.settings.slider_mobile_image
                      | image_url: width: 1200
                      | preload_tag: as: 'image', fetchpriority: 'high',
                      alt: block.settings.slider_mobile_image.alt
                    }}
                    {{
                      block.settings.slider_mobile_image
                      | image_url: width: width, height: height
                      | image_tag:
                        alt: block.settings.slider_mobile_image.alt,
                        class: 'img-fluid',
                        loading: loading,
                        fetchpriority: fetchpriority,
                        width: width,
                        format: format,
                        height: height,
                        widths: widths,
                        sizes: '(max-width: 767px) 70vw, 33vw'
                    }}
                  </a>
                {%- endif %}

              {% if collection == blank and  block.settings.slider_mobile_image == blank  %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder_svg position-absolute'  }}
             {% endif %}
              </div>
            </div>
          {% endfor %}
          {% endfor %}
      </div>
    </div>
    <div class="search_container overflow-auto color-{{ section.settings.color_scheme_block }} gradient  text-center d-flex align-items-center justify-content-center flex-column mx-auto">
      <div class="content_wrapper overflow-y-auto px-2 px-md-0">
        <div class="swiper thumb-slider thumb-slider-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div
                class="swiper-slide {%  if forloop.first %}wdt-active{% endif %}"
                data-id="loop-{{ section.id }}-{{ forloop.index }}"   {{ block.shopify_attributes }}
              >
                <div class="content_wrapper-active text-{{ block.settings.content_alignment }} mx-3">
                  {% if block.settings.heading != blank %}
                    <h2 class="{{ block.settings.heading_size }} text-break px-lg-4 mx-lg-2 px-2">{{ block.settings.heading }}</h2>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="text-break px-lg-4 mx-lg-2 px-2">{{ block.settings.text }}</p>
                  {% endif %}
                  <div class="mx-lg-2 px-2 px-lg-4">
                    {% if block.settings.button_label != blank %}
                      <a
                        class="btn btn-primary rounded-pill text-break mb-3 {% if block.settings.link == blank %} disabled {% endif %}"
                        {% if block.settings.link != blank %}
                          href="{{ block.settings.link }}"
                          aria-label="button"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                        {% if block.settings.target %}
                          target="_blank"
                        {% endif %}
                      >
                        {{ block.settings.button_label }}
                      </a>
                    {% endif %}
                 </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="search_box_wrapper d-sm-block d-none w-100 pt-3 px-md-3 px-md-2 px-0  mt-lg-5 text-break">
          <h2 class="mb-3  px-md-0 px-2 {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
          <form
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            class="d-flex mx-3 position-relative row-gap-3 flex-column flex-md-row newsletter-form form_input"
          >
            <label for="image_searchBox" class="visually-hidden">{{ 'general.search.search' | t }}</label>
            <input
              type="text"
              name="q"
              id="image_searchBox"
              placeholder="{{ 'general.search.search-placeholder' | t }}"
              class="form-control input_control"
              aria-label="{{ 'general.search.search' | t }}"
              required
            >
            <button
              type="submit"
              class="btn btn-primary position-absolute input_button"
              aria-label="{{ 'general.search.search' | t }}"
            >
              <span>
                <span class="d-none d-md-inline"> {{ 'general.search.search' | t }} </span>
                <span class="d-md-none" aria-hidden="true">{% render 'icon-search' %}</span>
              </span>
            </button>
          </form>
          <p class="my-3 mt-4 mt-md-5 text-break">{{ section.settings.description }}</p>
        </div>
        <div class="d-flex flex-wrap justify-content-center align-items-center px-3">
        {% assign any_collection = false %}
        {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
        {% assign any_collection = true %}
        {% endif %}
        {% endfor %}
          {% for block in section.blocks %}
          {%- if block.settings.collection != blank -%}
              <div>
                <a
                  href="{{ routes.collections_url }}/{{ block.settings.collection.handle }}"
                  class="btn btn-outline-primary collection-btn m-2 d-flex align-items-center column-gap-1"
                >
                  {{ block.settings.collection.all_products_count }}
                  {% render 'collection_count' %}
                  {{ block.settings.collection.title | escape }}
                </a>
              </div>
          {% endif %}

        {% endfor %}
            {% unless any_collection %}
            {% for collection in collections limit: 4 %}
              <a href="{{ routes.collections_url }}/{{ collection.handle }}" class="btn btn-outline-primary collection-btn m-2">
                {{ collection.all_products_count }}
                {% render 'collection_count' %}
                {{ collection.title | escape }}
              </a>
            {% endfor %}
          {% endunless %}
        </div>
      </div>
       <div class="mt-5 pt-2 d-none d-md-block position-absolute start-50 translate-middle-x cstm_scroll_btn ">
          <button class="scrollButton btn p-0 border-0" aria-label="scroll to next">
            {% render 'icon-home-slider' %}
          </button>
        </div>
    </div>
  </div>
</div>
  {% assign duration = section.settings.duration | times:1000 %}
   <script>
document.addEventListener("DOMContentLoaded", function() {
    function image_gallery__swiper() {

        const scrollButtons = document.querySelectorAll('.scrollButton');

        scrollButtons.forEach(button => {
            button.addEventListener('click', function() {
                const currentSection = button.closest('section');
                const sections = document.querySelectorAll('section');

                let nextSection = null;


                sections.forEach((section, index) => {
                    if (section === currentSection) {
                        nextSection = sections[index + 1];
                    }
                });

                if (nextSection) {
                    nextSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        const isMobile = window.innerWidth < 768;
        const existingSwiper = document.querySelector(".my-image_gallery__swiper-{{ section.id }}")?.swiper;
        if (existingSwiper) {
            existingSwiper.destroy(true, true);
        }

        var swiper = new Swiper(".my-image_gallery__swiper-{{ section.id }}", {
            loop: true,
            effect: "creative",
            spaceBetween: 0,
            centeredSlides: true,
            initialSlide: 2,
            navigation: {
                nextEl: ".home_slider_next-{{ section.id }}",
                prevEl: ".home_slider_prev-{{ section.id }}",
            },
            keyboard: {
                enabled: true
            },
            creativeEffect: {
                perspective: true,
                prev: {
                    translate: ["-80%", "14vw", -100],
                    rotate: [0, 0, -25],
                    scale: 0.7,
                    origin: "center",
                },
                next: {
                    translate: ["80%", "14vw", -100],
                    rotate: [0, 0, 25],
                    scale: 0.7,
                    origin: "center",
                }
            },
            breakpoints: {
                767.98: {
                    slidesPerView: 1,
                    effect: "slide"
                },
                768: {
                    slidesPerView: 3,
                    effect: "creative"
                }
            },
            on: {
                slideChangeTransitionEnd: function() {
                    if (swiper && swiper.slides) {
                        swiper.update();
                    }
                    removeTabindexFromActiveSlide(this);
                },
                slideChange: function() {
                    removeTabindexFromActiveSlide(this);
                    if (swiper && swiper.slides && swiper.slides.length > 0) {
                        var activeSlide = swiper.slides[swiper.activeIndex];
                        var activeSlideId = activeSlide.getAttribute('data-id');
                        if (activeSlideId) {
                            var matchingElement = document.querySelector(`.thumb-slider-{{ section.id }} .swiper-slide[data-id="${activeSlideId}"]`);
                            if (matchingElement) {
                                document.querySelectorAll('.thumb-slider-{{ section.id }} .swiper-slide.wdt-active').forEach(function(elem) {
                                    elem.classList.remove('wdt-active');
                                });
                                matchingElement.classList.add('wdt-active');
                            }
                        }
                    }
                }
            }
        });
    }

    function removeTabindexFromActiveSlide(swiperInstance) {

        const allSlides = document.querySelectorAll('.my-image_gallery__swiper-{{ section.id }} .swiper-slide');

        allSlides.forEach(slide => {
            if (slide.classList.contains('swiper-slide-active')) {
                slide.removeAttribute('tabindex');
                slide.querySelectorAll('a').forEach(anchor => {
                    anchor.removeAttribute('tabindex');
                });
            } else {
                slide.setAttribute('tabindex', '-1');
                slide.querySelectorAll('a').forEach(anchor => {
                    anchor.setAttribute('tabindex', '-1');
                });
            }
        });
    }
    setTimeout(function(){ image_gallery__swiper(); } , 50);
    document.addEventListener('shopify:block:select', function(event) {
        var blockId = event.detail.blockId;
        image_gallery__swiper();
    });
    document.addEventListener('shopify:section:load', function(event) {
        image_gallery__swiper();
    });
});

</script>
{% schema %}
{
  "name": "t:sections.home-slider.name",
  "tag": "section",
  "class": "section section-image-gallery",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.home-slider.settings.search_container.header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_block",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Search our site",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "description",
      "default": "Use this text to share the information which you like!.",
      "label": "t:sections.all.description.label"
    },

    {
      "type": "select",
      "id": "icon_style",
      "label": "t:sections.home-slider.settings.search_container.settings.icon_info.label",
      "info": "t:sections.home-slider.settings.search_container.settings.icon_info.info",
      "options": [
        {
          "value": "art",
          "label": "t:settings_schema.card.settings.arrow_style.option_1.label"
        },
        {
          "label": "t:settings_schema.card.settings.arrow_style.option_3.label",
          "value": "default"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.swiper.heading"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.all.pagination.label",
      "default": "arrow",
      "options": [
        {
          "label": "t:sections.all.pagination.option_2.label",
          "value": "arrow"
        },
        {
          "label": "t:sections.all.pagination.option_3.label",
          "value": "none"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.all.pagination_style.label",
      "visible_if": "{{ section.settings.pagination != 'none' }}",
      "default": "artistic",
