{% render 'spacing' %}
{% style %}
  .home_slider .my-image_gallery__swiper { overflow: visible;}
  .home_slider .my-carousel__actions { display: flex; justify-content: space-around; align-items: center; gap: 140px; position: relative; width: 100%;transform: translateY(12vw);z-index: 100; height:0; }
  .home_slider .swiper-card { display: flex; align-items: center; justify-content: center; }
  .home_slider:is(img) { width: 100%; height: 100%; object-fit: cover; }
  .home_slider.home_slider-{{ section.id }} .search_container {
  margin-bottom: var(--margin-circle);
  -webkit-border-radius: 50%;
  border-radius: 50%;
  -webkit-box-shadow: 0px 0px 0px var(--margin-circle) rgba(var(--color-background),{{ section.settings.curve_opacity | minus: 20 | times: 0.01 }});
  box-shadow: 0px 0px 0px var(--margin-circle) rgba(var(--color-background),{{ section.settings.curve_opacity | minus: 20 | times: 0.01}});
  display: flex; flex-direction: column; align-items: center; justify-content: center; scrollbar-width: none;
  filter: drop-shadow(0px 0px 1px rgba(var(--color-foreground), 0.2));
  }
  .home_slider .thumb-slider .swiper-slide { opacity: 0; display:none; transition: all .3s ease-out; }
  .home_slider .thumb-slider .swiper-slide.wdt-active { opacity: 1; display:block; }
  .home_slider .search_container > .content_wrapper { max-width: 80%; scrollbar-width:none;  width:100%; }
  .section-header:has(.top_main-title) ~ #MainContent > .section-image-gallery:first-child .home_slider {
  margin-top: calc(-1 * var(--margin-circle) - 2.5vw);
  background: transparent;
  }
  .home_slider .swiper.my-image_gallery__swiper:not(.swiper-initialized) .swiper-slide[data-id='loop-{{ section.id }}-1']{
  transform: translate3d(26%, 13vw, -100px) rotateX(0deg) rotateY(0deg) rotateZ(-25deg) scale(0.65);
  z-index:7;
  }
  .home_slider .swiper.my-image_gallery__swiper:not(.swiper-initialized) .swiper-slide[data-id='loop-{{ section.id }}-2']{
  z-index:8;
  }
  .home_slider .swiper.my-image_gallery__swiper:not(.swiper-initialized) .swiper-slide[data-id='loop-{{ section.id }}-3']{
  transform: translate3d(-26%, 13vw, -100px) rotateX(0deg) rotateY(0deg) rotateZ(25deg) scale(0.65);
  z-index:7;
  }
  .home_slider .swiper.my-image_gallery__swiper .swiper-slide{width:100%;}
  .ratio-custom{--bs-aspect-ratio: 90%;}
  .section-header+.Announcement ~ #MainContent > .section-image-gallery:first-child .home_slider {
  margin-top: 0;
  background: rgb(var(--color-background));
  }
  .section-header:has(.no-curve-header .top_main-title) ~ #MainContent > .section-image-gallery:first-child .home_slider{margin-top: 0;}
  .home_slider .search_box_wrapper button { width: auto; display:flex; align-items:center; justify-content:center; }
  .home_slider .search_container > .content_wrapper > * { text-wrap: balance; }
  .home_slider .scrollButton svg{ fill:rgb(var(--color-foreground)); }
  .home_slider-{{ section.id }}.home_slider .scrollButton{
     transition:all 0.5s linear;
    {% if section.settings.icon_style == 'default' %}
      transform:rotate(180deg)
    {% endif %}
     }
  /* .home_slider .scrollButton:hover{ transform:translateY(5px); } */
  .home_slider .search_container .search_box_wrapper .form-control{ padding-right: 10rem; }
/*swipper intitialized on testing---start  */
{% unless request.design_mode %}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child  .swiper-wrapper:first-of-type {display:flex !important;transform: translateX(33%) !important;}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child .swiper-slide{transform:none !important;}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child .swiper-wrapper:first-of-type .swiper-slide:nth-child(1) {display:none !important}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child  .swiper-wrapper  .swiper-slide:nth-child(2) { width:23.8%; transform: rotate(335deg) translateY(84%) translateX(-28%) !important; z-index: 1;display:none !important;}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child .swiper-wrapper:first-of-type  .swiper-slide:nth-child(3) {transform: none; z-index: 3;}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child .swiper-wrapper:first-of-type  .swiper-slide:nth-child(4) {width:23.8%;right:-7%;z-index:1 !important;transform:rotate(25deg) translateY(98%)!important;display:none !important;}
.home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child .swiper-wrapper:first-of-type  .swiper-slide:nth-child(n + 5) {display:none !important;}
.home_slider:not(:has(.swiper-initialized)) .swiper.my-image_gallery__swiper .swiper-slide{width:33.9%;}
.home_slider:not(:has(.swiper-initialized)) .search_container{position:relative;z-index:2;}
.home_slider:has(.swiper-initialized) .my-carousel > .swiper > .swiper-wrapper > *:not(.swiper-slide-next,.swiper-slide-active,.swiper-slide-prev){ scale:0 !important;}

{% endunless %}
/*swipper intitialized on testing---end  */


  @media screen and (min-width: 1024px) {
  .home_slider .search_container { height: 100%; width: 100%; aspect-ratio: 1; max-width: 900px; padding: 6rem 1rem; }
  }
    @media screen and (min-width: 2000px) {
  .home_slider .search_container { height: 100%; width: 100%; aspect-ratio: 1; max-width: 1050px; padding: 6rem 1rem; }
  }
  @media screen and (max-width: 1024px) {
  .home_slider .search_container { height: 100%; width: 100%; aspect-ratio: 1; max-width: 768px; position: relative;  padding: 6rem 1rem;}
  /* left: 50%; -webkit-transform: translateX(-50%); transform: translateX(-50%); */
  .home_slider .search_container > .content_wrapper { width: 85%; max-width: 100%;}
  /* .home_slider .search_container.overflow-y-scroll { overflow-y: unset !important;} */
  .home_slider .my-carousel__actions{ transform: translateY(10vw); }
  }
  @media (min-width: 768px) {
  .home_slider .search_box_wrapper button { width: revert-layer;}
  .home_slider .search_container > .content_wrapper { max-width: 85%; padding:24px 24px 0 24px;}
  .home_slider .swiper.my-image_gallery__swiper .swiper-slide{width:33.33%;}
  }
  @media (max-width: 767.98px) {
  .home_slider .swiper-card{width:70%;margin:auto}
  .home_slider .swiper.my-image_gallery__swiper .swiper-slide:not(.swiper-slide-active){opacity:0;visibility:hidden;}
  .home_slider .my-image_gallery__swiper { max-width: 100%;}
  .home_slider .my-carousel__control { width: calc(50vw - 28% );}
  .home_slider .my-carousel__actions { justify-content: space-between; transform: translateY(25vw);}
  .home_slider .my-carousel__actions .swiper-prev {margin-left:20px; }
  .home_slider .my-carousel__actions .swiper-next {margin-right:20px; }
  .home_slider .my-carousel__actions .swiper-prev:hover,
  .home_slider .my-carousel__actions .swiper-next:hover {transform:none; }
  .home_slider .swiper.my-image_gallery__swiper:not(.swiper-initialized) .swiper-slide[data-id='loop-{{ section.id }}-1']{transform: none; z-index:7;}
  .home_slider .search_container .search_box_wrapper .form-control{ padding-right: 6rem; }

  .home_slider:not(:has(.swiper-initialized)) .my-carousel > .swiper > .swiper-wrapper > *{scale: 1 !important;opacity: 1 !important;visibility: visible !important;}
  .home_slider:not(:has(.swiper-initialized)) .my-carousel > .swiper > .swiper-wrapper > *:not(:nth-child(3)){display:none !important;}
  .home_slider:not(:has(.swiper-initialized)) .my-carousel >*:first-child  .swiper-wrapper:first-of-type {transform: none !important;}
  .home_slider:not(:has(.swiper-initialized)) .swiper.my-image_gallery__swiper .swiper-slide{width:100% !important;}
  }

  @media (max-width: 575.98px) {
  .home_slider .search_container {  padding: 4rem 1rem 1rem 1rem;}
 .home_slider .form-control{padding-left:1rem;}
  }
  .section-header:has(.no-curve-header .top_main-title) ~ #MainContent > .section-image-gallery .home_slider{
  padding: var(--margin-circle) 0;
  }
  .home_slider .search_box_wrapper button svg {
  width: 20px;
  height: 20px;
  }
  .my-image_gallery__swiper .swiper-slide a:focus-within img{
  border: 2px dashed;
  }

.home_slider .swiper-wrapper{isolation:isolate;}
.home_slider .cstm_scroll_btn{bottom:30px;}

