{% liquid
  assign section_id = 'nutrition-goals-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="nutrition-goals"
  style="
    --ng-background: {{ section.settings.background_color }};
    --ng-text: {{ section.settings.text_color }};
    --ng-description: {{ section.settings.description_color }};
    --ng-check: {{ section.settings.check_color }};
    --ng-button-bg: {{ section.settings.button_background }};
    --ng-button-text: {{ section.settings.button_text }};
  "
>

  <div class="nutrition-goals__container">

    <!-- =====================================================
         IMAGE
    ====================================================== -->

    <div class="nutrition-goals__media">

      {% if section.settings.desktop_image != blank %}

        <picture class="nutrition-goals__picture">

          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 400 }} 400w,
                {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
                {{ section.settings.mobile_image | image_url: width: 800 }} 800w,
                {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w,
                {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {% endif %}

          {{
            section.settings.desktop_image
            | image_url: width: 1920
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400, 1600, 1920',
              sizes: '(max-width: 749px) 100vw, 50vw',
              alt: section.settings.image_alt,
              class: 'nutrition-goals__image'
          }}

        </picture>

      {% else %}

        <div class="nutrition-goals__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="nutrition-goals__content">

      <div class="nutrition-goals__content-inner">

        {% if section.settings.heading != blank %}

          <h2 class="nutrition-goals__heading">
            {{ section.settings.heading | escape }}
          </h2>

        {% endif %}


        {% if section.settings.description != blank %}

          <div class="nutrition-goals__description">
            {{ section.settings.description }}
          </div>

        {% endif %}


        {% if section.blocks.size > 0 %}

          <div class="nutrition-goals__benefits">

            {% for block in section.blocks %}

              {% if block.type == 'benefit' and block.settings.text != blank %}

                <div
                  class="nutrition-goals__benefit"
                  {{ block.shopify_attributes }}
                >

                  <span
                    class="nutrition-goals__check"
                    aria-hidden="true"
                  >

                    <svg
                      width="18"
                      height="13"
                      viewBox="0 0 18 13"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M17.2 1.06006L6.19995 12.0601L1.19995 7.06006"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                  </span>

                  <p class="nutrition-goals__benefit-text">
                    {{ block.settings.text | escape }}
                  </p>

                </div>

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}


        {% if section.settings.button_label != blank %}

          <div class="nutrition-goals__button-wrapper">

            {% if section.settings.button_link != blank %}

              <a
                href="{{ section.settings.button_link }}"
                class="nutrition-goals__button"
              >

            {% else %}

              <button
                type="button"
                class="nutrition-goals__button"
              >

            {% endif %}

                <span>
                  {{ section.settings.button_label | escape }}
                </span>

                {% if section.settings.show_button_arrow %}

                  <span
                    class="nutrition-goals__button-icon"
                    aria-hidden="true"
                  >

                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M4.1 12H20.1M20.1 12L14.1 6M20.1 12L14.1 18"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                  </span>

                {% endif %}

            {% if section.settings.button_link != blank %}
              </a>
            {% else %}
              </button>
            {% endif %}

          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>


{% style %}

/* =========================================================
   SECTION
========================================================= */

#{{ section_id }} {
  width: 100%;

  background: var(--ng-background);
  color: var(--ng-text);

  padding-top: 72px;
  padding-bottom: 72px;

  overflow: hidden;
}

#{{ section_id }},
#{{ section_id }} *,
#{{ section_id }} *::before,
#{{ section_id }} *::after {
  box-sizing: border-box;
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

#{{ section_id }} .nutrition-goals__container {
  width: 100%;

  max-width: 1800px;

  margin-left: auto;
  margin-right: auto;

  padding-left: 40px;
  padding-right: 40px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr);

  gap: 40px;

  align-items: center;
}


/* =========================================================
   IMAGE
========================================================= */

#{{ section_id }} .nutrition-goals__media {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  line-height: 0;
}

#{{ section_id }} .nutrition-goals__picture {
  display: block;

  width: 100%;
  max-width: 100%;

  line-height: 0;
}

#{{ section_id }} .nutrition-goals__image {
  display: block;

  width: 100%;
  max-width: 100%;

  height: auto;

  /*
    IMPORTANT:
    No fixed height.
    No aspect-ratio.
    No object-fit: cover.
    Uploaded image keeps its natural ratio.
  */
}


/* =========================================================
   IMAGE PLACEHOLDER
========================================================= */

#{{ section_id }} .nutrition-goals__placeholder {
  width: 100%;

  line-height: 0;
}

#{{ section_id }} .nutrition-goals__placeholder svg {
  display: block;

  width: 100%;
  height: auto;
}


/* =========================================================
   CONTENT
========================================================= */

#{{ section_id }} .nutrition-goals__content {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: center;
}

#{{ section_id }} .nutrition-goals__content-inner {
  width: 100%;
}


/* =========================================================
   HEADING
========================================================= */

#{{ section_id }} .nutrition-goals__heading {
  margin: 0 0 18px;
  padding: 0;

  color: var(--ng-text);

  font-size: 50px;
  line-height: 1.08;

  font-weight: 400;

  letter-spacing: -0.035em;
}


/* =========================================================
   DESCRIPTION
========================================================= */

#{{ section_id }} .nutrition-goals__description {
  margin: 0 0 28px;

  color: var(--ng-description);

  font-size: 19px;
  line-height: 1.45;

  font-weight: 400;
}

#{{ section_id }} .nutrition-goals__description p {
  margin: 0;
}

#{{ section_id }} .nutrition-goals__description p + p {
  margin-top: 12px;
}


/* =========================================================
   BENEFITS
========================================================= */

#{{ section_id }} .nutrition-goals__benefits {
  width: 100%;

  display: flex;
  flex-direction: column;

  gap: 18px;

  margin: 0 0 32px;
}

#{{ section_id }} .nutrition-goals__benefit {
  width: 100%;

  display: flex;
  align-items: flex-start;

  gap: 14px;
}

#{{ section_id }} .nutrition-goals__check {
  width: 24px;
  min-width: 24px;

  height: 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--ng-check);

  margin-top: 1px;
}

#{{ section_id }} .nutrition-goals__check svg {
  display: block;

  width: 18px;
  height: 13px;
}

#{{ section_id }} .nutrition-goals__benefit-text {
  flex: 1;

  min-width: 0;

  margin: 0;

  color: var(--ng-text);

  font-size: 15px;
  line-height: 1.45;

  font-weight: 400;
}


/* =========================================================
   BUTTON
========================================================= */

#{{ section_id }} .nutrition-goals__button-wrapper {
  width: 100%;
}

#{{ section_id }} .nutrition-goals__button {
  width: 100%;

  min-height: 58px;

  padding: 14px 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  background: var(--ng-button-bg);
  color: var(--ng-button-text);

  border: 0;
  border-radius: 30px;

  text-decoration: none;

  font-family: inherit;
  font-size: 16px;
  line-height: 1.25;
  font-weight: 400;

  cursor: pointer;

  transition:
    background-color 0.2s ease,
    color 0.2s ease,
    opacity 0.2s ease;
}

#{{ section_id }} .nutrition-goals__button:hover {
  opacity: 0.9;
}

#{{ section_id }} .nutrition-goals__button-icon {
  width: 20px;
  height: 20px;

  flex: 0 0 20px;

  display: flex;
  align-items: center;
  justify-content: center;
}

#{{ section_id }} .nutrition-goals__button-icon svg {
  display: block;

  width: 100%;
  height: 100%;
}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 989px) {

  #{{ section_id }} .nutrition-goals__container {
    padding-left: 32px;
    padding-right: 32px;

    gap: 28px;
  }

  #{{ section_id }} .nutrition-goals__heading {
    font-size: 42px;
  }

  #{{ section_id }} .nutrition-goals__description {
    font-size: 17px;
  }

  #{{ section_id }} .nutrition-goals__benefit-text {
    font-size: 15px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  #{{ section_id }} {
    padding-top: 48px;
    padding-bottom: 48px;
  }


  /*
    IMAGE FIRST
  */

  #{{ section_id }} .nutrition-goals__container {
    width: 100%;

    display: flex;
    flex-direction: column;

    gap: 30px;

    padding-left: 20px;
    padding-right: 20px;
  }


  #{{ section_id }} .nutrition-goals__media {
    order: 1;

    width: 100%;
  }


  /*
    CONTENT SECOND
  */

  #{{ section_id }} .nutrition-goals__content {
    order: 2;

    width: 100%;
  }


  /*
    MOBILE IMAGE KEEPS ORIGINAL RATIO
  */

  #{{ section_id }} .nutrition-goals__picture {
    display: block;

    width: 100%;
  }

  #{{ section_id }} .nutrition-goals__image {
    display: block;

    width: 100%;
    height: auto;

    max-width: 100%;

    object-fit: initial;
  }


  /*
    MOBILE HEADING
  */

  #{{ section_id }} .nutrition-goals__heading {
    margin: 0 0 16px;

    font-size: 34px;
    line-height: 1.08;

    letter-spacing: -0.025em;
  }


  /*
    MOBILE DESCRIPTION
  */

  #{{ section_id }} .nutrition-goals__description {
    margin: 0 0 24px;

    font-size: 16px;
    line-height: 1.45;
  }


  /*
    MOBILE BENEFITS
  */

  #{{ section_id }} .nutrition-goals__benefits {
    gap: 18px;

    margin-bottom: 28px;
  }

  #{{ section_id }} .nutrition-goals__benefit {
    gap: 11px;
  }

  #{{ section_id }} .nutrition-goals__benefit-text {
    font-size: 14px;
    line-height: 1.45;
  }

  #{{ section_id }} .nutrition-goals__check {
    width: 21px;
    min-width: 21px;
    height: 21px;
  }


  /*
    MOBILE BUTTON
  */

  #{{ section_id }} .nutrition-goals__button {
    min-height: 52px;

    padding-left: 20px;
    padding-right: 20px;

    font-size: 15px;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media screen and (max-width: 420px) {

  #{{ section_id }} .nutrition-goals__container {
    padding-left: 16px;
    padding-right: 16px;
  }

  #{{ section_id }} .nutrition-goals__heading {
    font-size: 32px;
  }

}

{% endstyle %}


