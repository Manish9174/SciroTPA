{% liquid
  assign height = ''
  case section.settings.height
    when 'small'
      assign height = '600px'
    when 'medium'
      assign height = '700px'
    when 'large'
      assign height = '950px'
    when 'adapt'
      assign height = 'auto'
    else
      assign height = '950px'
  endcase
  assign mobile_height = ''
  case section.settings.mobile_height
    when 'small'
      assign mobile_height = '600px'
    when 'medium'
      assign mobile_height = '700px'
    when 'large'
      assign mobile_height = '950px'
    when 'adapt'
      assign mobile_height = 'auto'
    else
      assign mobile_height = '950px'
  endcase
%}

{% style %}
      .slideshow_next-{{ section.id }}:focus-visible,
      .slideshow_prev-{{ section.id }}:focus-visible{
        outline:none;
      }
      .slideshow_next-{{ section.id }}:focus-visible svg,
      .slideshow_prev-{{ section.id }}:focus-visible svg{
        outline:2px solid;
        outline-offset:2px;
        border-radius:inherit;
      }
          .slideshow.section-{{ section.id }}-padding .swiper-nav-prev:hover{transform:translateX(-10px);}
          .slideshow.section-{{ section.id }}-padding .swiper-nav-next:hover{transform:translateX(10px);}
          .search_box_wrapper .form-control{ padding-right: 10rem; }

          .slideshow.section-{{ section.id }}-padding .swiper-prev,
          .slideshow.section-{{ section.id }}-padding .swiper-next{
              height: fit-content;
              padding: 5px;
          }
          .slideshow.section-{{ section.id }}-padding .swiper-nav-prev{left:20px; }
          .slideshow.section-{{ section.id }}-padding .swiper-nav-next {right:20px}
          .slideshow.section-{{ section.id }}-padding .swiper-nav-prev,
          .slideshow.section-{{ section.id }}-padding .swiper-nav-next {
            position: absolute !important;
            z-index:2;
            padding:0.5rem;
            top:0;
            bottom:0;
            margin:auto;
            transition:all 0.5s linear;
          }

        .swiper-navigation .swiper-nav-prev, .swiper-navigation .swiper-nav-next {
          display: flex;
          color: rgba(var(--color-foreground));
          cursor: pointer;
          width: 60px;
          height: 60px;
          justify-content: center;
          align-items: center;
          border: 1px solid rgba(var(--color-foreground));
          border-radius: 50px;
      }
        .swiper-navigation .swiper-nav-prev svg.icon_two, .swiper-navigation .swiper-nav-next svg.icon_two{
          width:18px;
          height:18px
        }
        .swiper-navigation .swiper-nav-prev svg.icon_one, .swiper-navigation .swiper-nav-next svg.icon_one{
          width:40px;
          height:30px;
        }
        .swiper-pagination-clickable .swiper-pagination-bullet {
          cursor: pointer;
          opacity: 1;
      }
        {% if section.settings.height == 'adapt' %}
        .slideshow.section-{{ section.id }}-padding .img-height {
          height: auto;
        }
          {% endif %}
        {%  if section.settings.height != 'adapt'  %}
           @media (min-width: 576px) {
        .slideshow.section-{{ section.id }}-padding .swipper_banner{
          min-height:{{ height | times: 0 | round: 0 }}px;
        }
        }
         @media (min-width: 576px) {
        .slideshow.section-{{ section.id }}-padding .img-height{
          min-height:{{ height | times: 0.7 | round: 0 }}px;
        }
        }
         @media (min-width: 992px) {
        .slideshow.section-{{ section.id }}-padding .img-height{
          min-height:{{ height | times: 0.8 | round: 0 }}px;
        }
        }
        @media (min-width: 1200px) {
        .slideshow.section-{{ section.id }}-padding .img-height{
          min-height:{{ height | times: 0.9 | round: 0 }}px;
        }
        }
        @media (min-width: 1400px) {
        .slideshow.section-{{ section.id }}-padding .img-height{
          min-height:{{ height | times: 1.12 | round: 0 }}px;
        }
        }
           {% endif %}
        .slideshow.section-{{ section.id }}-padding .content-block{
          background:rgba(var(--color-background),var(--bg-opacity));
          max-height:100%;
          overflow:auto;
          scrollbar-width: thin;
        }
      .swipper_banner.placeholder-svg{height:100%;}
      .slideshow.section-{{ section.id }}-padding .swiper-pagination{
      position: absolute;
      bottom: 10%;
      left: 0;
      right: 0;
      }
      .swipper_banner {width:100%;height:100%;}
      .slideshow.section-{{ section.id }}-padding .swiper-pagination{margin-bottom:20px;}

      @media screen and (max-width:767.98px){
       .search_box_wrapper .form-control{ padding-right: 6rem; }
      }
      @media screen and (max-width:575px){
        {% if section.settings.bottom_placement %}
      .slideshow.section-{{ section.id }}-padding .swiper-slide {height:100% !important}
        {% endif %}
      {% if section.settings.mobile_height != 'adapt' %}
      .slideshow.section-{{ section.id }}-padding .swipper_banner{min-height:{{ mobile_height | times: 0.6 | round: 0 }}px; position:relative;}
      .slideshow.section-{{ section.id }}-padding .swipper_banner .mobile-img-height {
      position: absolute;
      top: 0;
      left: 0;
      object-fit: cover;
      }
      {% else %}
      .slideshow.section-{{ section.id }}-padding .swipper_banner{position:relative;}
      .slideshow.section-{{ section.id }}-padding .swipper_banner::before{
        {% assign aspect_ratio = 1 | divided_by: section.blocks.first.settings.mobile_image.aspect_ratio | times: 100  %}
      padding-bottom: {{ aspect_ratio | default: 100 }}%;
      content: '';
      display: block;
      }
      .slideshow.section-{{ section.id }}-padding .swipper_banner .mobile-img-height{ position:absolute; height:100%; top:0; object-fit: cover; }
      {% endif %}
      }
       @media screen and (min-width:576px){
      .swipper_banner,.banner-overlay{
        grid-area:1/-1;
      }
      }
  {% unless section.settings.bottom_placement %}
     .slideshow.section-{{ section.id }}-padding .swipper_banner,
      .slideshow.section-{{ section.id }}-padding .banner-overlay{
        grid-area:1/-1;
      }
    {% endunless %}
        /* .slideshow.section-{{ section.id }}-padding .swiper-wrapper .banner-overlay:not(.mobile) .content-block{ width: 90vw; } */
        @media (min-width: 576px) { .slideshow.section-{{ section.id }}-padding .swiper-wrapper .banner-overlay:not(.mobile) .content-block { max-width: var(--content-width); }}

        /* .scrollButton svg{ fill:rgb(var(--color-foreground)); }
        .scrollButton{ transition:all 0.5s linear; transform:rotate(180deg) }
        .scrollButton:hover{ transform:translateY(5px) rotate(180deg); } */
        .slideshow .swiper{padding:0px !important;}
      .section-{{ section.id }} .swiper-navigation .swiper-next, .section-{{ section.id }} .swiper-navigation .swiper-prev{
        padding: 0.5rem;
        top: 0;
        bottom: 0;
        margin: auto;
        transition: all 0.5s linear;
      }
      .section-{{ section.id }} .swiper-navigation .swiper-next{ right: 20px; }
      .section-{{ section.id }} .swiper-navigation .swiper-prev{ left: 20px; }
      @media screen and (max-width:575.98px){

      .slideshow_prev-{{ section.id }}.swiper-prev.main-prev{
        position:relative !important;
        /* margin-top:10px;
        margin-bottom:10px; */
        width: fit-content;
        left: 0px !important;
        margin-block: 20px !important;
      }
      .slideshow_next-{{ section.id }}.swiper-next.main-next{
      position:relative !important;
      width: fit-content;
      /* margin-top:10px;
      margin-bottom:10px; */
      right: 0px !important;
      margin-block: 20px !important;
      }
      .section-{{ section.id }} .swiper-navigation .swiper-next, .section-{{ section.id }} .swiper-navigation .swiper-prev{
        padding: 0.5rem;
        top: 0;
        bottom: 0;
        margin: unset;
        transition: all 0.5s linear;
      }
      }
      /* .section-slideshow .swiper-wrapper .swiper-slide .banner-overlay{
        opacity:0;
      }
      .section-slideshow  .swiper-wrapper .swiper-slide.swiper-slide-active .banner-overlay{
        opacity:1;        
      } */

{% endstyle %}

{% liquid

    assign auto_play = section.settings.autoplay_delay
    assign centered_mode = false
    assign loop_slide = false
    assign dots = section.settings.swiper_pagination
    assign space = 0
    assign effect = section.settings.animation
    assign slider_desktop = 1
    assign slider_laptop = 1
    assign slider_tablet = 1
    assign slider_mobile = 1


%}
<div class="slideshow section-{{ section.id }} section-{{ section.id }}-padding {% if section.settings.full_width %} container-fluid px-0{% else %} container gx-5 gx-sm-4 overflow-hidden {% endif %}">

      <review-swiper-slide>
        <div
          data-slider-options='
            {
                "desktop": "{{ slider_desktop }}",
                "laptop": "{{ slider_laptop }}",
                "tablet": "{{ slider_tablet }}",
                "mobile": "{{ slider_mobile }}",
                "loop": "{{ loop_slide }}",
                "mode": "{{ centered_mode }}",
                "auto_play": "{{ auto_play }}",
                "dots": "{{ dots }}",
               "space": "{{ space }}",
               "effect":"{{ effect }}"
            }
          '
        >

    <div class="swiper mySwiper-{{ section.id }} position-relative overflow-hidden" data-swiper-slider {% if settings.animation != 'none' %} data-aos="{{ settings.animation}}"{% endif %} >
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
      <div class="swiper-slide{% if section.settings.mobile_height == 'adapt' and section.settings.bottom_placement %} d-flex d-sm-grid flex-column {% endif %} h-auto d-grid">
          {% style %}
            .mySwiper-{{ section.id }} #swiper-image-{{ forloop.index }}.swipper_banner::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,{{ block.settings.image_transparent }})}
          {% endstyle %}
          <div
            class="swipper_banner {% unless section.settings.height == "adapt" %} position-sm-absolute inset-0 {% endunless %} {% if block.settings.image == blank %} placeholder-svg {% endif %}"
            id="swiper-image-{{ forloop.index }}"
          >
            {% if block.settings.image != blank %}
              {% if forloop.first %}
                {{
                  block.settings.image
                  | image_url: width: 1920
                  | image_tag: class: 'w-100 d-none d-sm-block h-100 object-fit-cover', loading: 'eager'
                }}
              {% else %}
                {{
                  block.settings.image
                  | image_url: width: 1920
                  | image_tag: class: 'w-100 d-none d-sm-block h-100 object-fit-cover', loading: 'lazy'
                }}
              {% endif %}
            {% else %}
              {%- assign placeholder_image_index = forloop.index0 | modulo: 2 | plus: 1 -%}
              {%- assign placeholder_image = 'lifestyle-' | append: placeholder_image_index -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg bg-light w-100 h-100 d-none d-sm-block' }}
            {% endif %}
            {% if block.settings.mobile_image != blank %}
              {% if forloop.first %}
                {{
                  block.settings.mobile_image
                  | image_url: width: 768
                  | image_tag: class: 'object-fit-cover w-100 d-block d-sm-none mobile-img-height', loading: 'eager'
                }}
              {% else %}
                {{
                  block.settings.mobile_image
                  | image_url: width: 768
                  | image_tag: class: 'object-fit-cover w-100 d-block d-sm-none mobile-img-height', loading: 'lazy'
                }}
              {% endif %}
            {% else %}
              {%- assign placeholder_image_index = forloop.index0 | modulo: 2 | plus: 1 -%}
              {%- assign placeholder_image = 'collection-' | append: placeholder_image_index -%}
              {{
                placeholder_image
                | placeholder_svg_tag: 'placeholder-svg bg-light w-100  d-block d-sm-none mobile-img-height'
              }}
            {% endif %}
          </div>

          <div
            class="banner-overlay z-3 d-none d-sm-flex {{ block.settings.box_align }} text-{{ block.settings.content_alignment }}  container img-height"
            style=""
          >
            {% unless block.settings.heading == blank
              and block.settings.text == blank
              and block.settings.button_label == blank
            %}
              <div
                class="content-block color-{{ block.settings.color_scheme }} {% if block.settings.transparent > 0 %} p-3 p-md-3 p-lg-4 {% else %} p-1 {% endif %} rounded-2"
                style="--content-width:clamp(370px, 50vw, {{ block.settings.desktop_content_width }}px); background:rgba(var(--color-background),{{ block.settings.transparent }});"
              >
                {% if block.settings.heading != blank %}
                  <h2 class="{{ block.settings.heading_size }} text-break mb-3 pb-2">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="text-break mb-4 pb-3">{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a
                    class="btn btn-primary rounded-pill text-break {% if block.settings.link == blank %} disabled {% endif %}"
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    {% if block.settings.target %}
                      target="_blank"
                    {% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            {% endunless %}
          </div>
          <div
            class="banner-overlay mobile d-flex justify-content-center align-items-center d-sm-none z-1 {% unless section.settings.bottom_placement %} position-relative p-3 {% else %} h-100 {% endunless %}"
          >
            {% unless block.settings.heading == blank
              and block.settings.text == blank
              and block.settings.button_label == blank
            %}
              <div
                class="content-block col text-{{ block.settings.content_alignment }} px-3 {% unless section.settings.bottom_placement %} rounded-2 {% else %}  {% endunless %} color-{{ block.settings.color_scheme }} {% if section.settings.bottom_placement %} p-4 {% else %} p-3 {%  endif %} p-md-4 p-lg-5 mx-sm-4"
                style="background:rgba(var(--color-background),{{ block.settings.mobile_transparent }});"
              >
                {% if block.settings.heading != blank %}
                  <h2 class="{{ block.settings.heading_size }} text-break mb-4">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="text-break mb-4 pb-2">{{ block.settings.text }}</p>
                {% endif %}
                {% if block.settings.button_label != blank %}
                  <a
                    class="btn btn-primary rounded-pill text-break {% if block.settings.link == blank %} disabled {% endif %}"
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    {% if block.settings.target %}
                      target="_blank"
                    {% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>
                {% endif %}
              </div>
            {% endunless %}
          </div>
        </div>
      {% endfor %}
    </div>
        {% if section.settings.pagination == 'arrow' and section.blocks.size > 1 %}
      <div class="{% if section.settings.mobile_navigation %} d-flex justify-content-center align-items-center gap-5 {% else %} d-none {% endif %} d-sm-block swiper-navigation">
        <div class="position-absolute slideshow_prev-{{ section.id }} swiper-prev main-prev z-3 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
          {% render 'arrow-left' %}
        </div>
        <div class="position-absolute slideshow_next-{{ section.id }} swiper-next main-next z-3 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
          {% render 'arrow-right' %}
        </div>
      </div>
    {% endif %}
    {% assign swiper_class = 'mySwiper-' | append: section.id %}
    {% if section.settings.pagination == 'dots' %}
      <div class="{% if section.settings.mobile_navigation %} d-flex {% else %} d-none {% endif %} d-sm-flex justify-content-center align-items-baseline position-sm-absolute start-0 end-0 bottom-0 z-3 mt-5 mt-sm-0 my-3">
        <div class="lh-0">
          {% render 'pagination-styles', swiper-class: swiper_class %}
        </div>
      </div>
    {% endif %}
  </div>
   </div>
   </review-swiper-slide>

</div>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section section-slideshow",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.slideshow_options.header"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.image_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.height.options.small.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.height.options.medium.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.height.options.large.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.height.options.adapt.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:sections.slideshow.settings.mobile_image_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.height.options.small.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.height.options.medium.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.height.options.large.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.height.options.adapt.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "bottom_placement",
      "label": "t:sections.slideshow.settings.content_placement.label"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:sections.slideshow.settings.animation.label",
      "options": [
        {
          "value": "slide",
          "label": "t:sections.slideshow.settings.animation.options.option_1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.slideshow.settings.animation.options.option_2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.swiper.heading"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.all.pagination.label",
      "default": "arrow",
      "options": [
        {
          "label": "t:sections.all.pagination.option_1.label",
          "value": "dots"
        },
        {
          "label": "t:sections.all.pagination.option_2.label",
          "value": "arrow"
        },
        {
          "label": "t:sections.all.pagination.option_3.label",
          "value": "none"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.all.pagination_style.label",
      "default": "artistic",
      "options": [
        {
          "label": "t:sections.all.pagination_style.option_1.label",
          "value": "artistic"
        },
        {
          "label": "t:sections.all.pagination_style.option_2.label",
          "value": "bold"
        },
        {
          "label": "t:sections.all.pagination_style.option_3.label",
          "value": "regular"
        }
      ],
      "visible_if": "{{ section.settings.pagination != 'none'}}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 0,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 0,
      "label": "t:sections.all.swiper.autoplay",
      "info":  "t:sections.all.swiper.info",
    },
    {
      "type": "checkbox",
      "id": "mobile_navigation",
      "label": "t:sections.slideshow.settings.mobile_controls.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.desktop_image.label",
          "info": "1920 x 860px recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.slideshow.blocks.slide.settings.mobile_image.label",
          "info": "900 x 600px recommended"
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.block_feature"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "Tell your brand's story through images"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h3",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h2",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Tell your brand's story through images",
          "label": "t:sections.all.description.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button",
          "label": "t:sections.404-page.blocks.button.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.404-page.blocks.button.label-url"
        },
        {
          "type": "checkbox",
          "id": "target",
          "label": "t:sections.all.link_target.label"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "default": "center",
          "options": [
            {
              "value": "start",
              "label": "t:sections.all.content_alignment.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.all.content_alignment.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.all.content_alignment.options__3.label"
            }
          ],
          "label": "t:sections.all.content_alignment.label"
        },
        {
          "type": "select",
          "id": "box_align",
          "options": [
            {
              "value": "justify-content-start align-items-start",
              "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__1.label"
            },
            {
              "value": "justify-content-center align-items-start",
              "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__2.label"
            },
            {
              "value": "justify-content-end align-items-start",
              "label": "t:sections.slideshow.blocks.slide.settings.box_align.options__3.label"
            },
