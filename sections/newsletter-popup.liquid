{% style %}
   .newsletter_overlay{
  --bs-backdrop-bg: #000;
  --bs-backdrop-opacity: 1;
  top: 0;
  left: 0;
  z-index: 1049;
  width: 100vw;
  backdrop-filter: blur(6px);
   }
   #confirmModal_newsletter{
        height: 100%;
    max-height: min-content;
    scrollbar-width:none;
   }
   .newsletter_overlay:before{
     content:"";
  width:100%;
  height:100%;
  position:absolute;
  background-color: var( --bs-backdrop-bg);
  opacity:0.6;
   }
  .bg-overlay input[type='checkbox']{
    border-radius:50%;
  }
  .bg-overlay .form-check-label{
    cursor:pointer;
  }
  .bg-overlay form{
    width:100%;
  }
  .bg-overlay .rounded-circle.popup-modal{
    max-width:700px;
    min-width:450px;
    aspect-ratio:1/1;
    width:100%;
    box-shadow:0 0 1px 60px rgba(0,0,0,0.2);
    margin:60px;
    scrollbar-width: none;
    justify-content: center;
    align-items: center;
    padding:70px 0;
  }
    input.input_control{
      padding: 18px 40px !important;
    }
   @media screen and (min-width: 768px){
    input.input_control{
      padding-inline-end: calc(var(--email-btn-width) + 30px) !important;
    }
   }

  {% if section.settings.image == blank %}
  .bg-overlay .popup_content-block{padding-block:120px;}
  {% endif %}
  .bg-overlay .box-modal{
    max-width:600px;
    width:100%;
    scrollbar-width: none;
  }
  @media screen and (max-width:768px){
   .bg-overlay .popup-modal{
      margin:0;
    }
    .popup-modal .form_input, .popup-modal .info{ margin:1rem 2rem !important; }
  }
    @media screen and (max-width:575.98px){
      .popup-modal .form_input, .popup-modal .info{ margin: 1rem 0rem !important; }
      .bg-overlay .rounded-circle.popup-modal{ padding:55px 0;}
    }
    .popup-modal .newsletter_image img{ max-height:450px; border-radius: var(--bs-radius); }
    .newsletter-form button{ width: max(30%, 180px) !important; }
    {% if  section.settings.newsletter_shape == 'circle' %}
   .newsletter_overlay .btn-close{top:100px; right:30%; }
   .newsletter_overlay  .btn-close{
    /* background-color: rgb(var(--color-foreground));
    box-shadow: 0 0 1px 10px rgba(var(--color-foreground), 0.2); */
    opacity: 1;
    border: none;
    /* color: rgb(var(--color-background)); */
    }
      @media screen and (max-width:991.98px){
         .newsletter_overlay .btn-close{top:70px; }
      }
   {% else %}
     .newsletter_overlay .btn-close{
      top:15px;
      right:15px;
    }
    .newsletter_overlay .popup-modal{
      border-radius: var(--bs-radius);
      border: var(--bs-style-border) var(--bs-border-style) var(--bs-border-color)!important;
    }
    #confirmModal_newsletter{height:35vh !important;}
   {% endif %}
   .newsletter_overlay .newletter_wrapper{max-width:fit-content;max-height:fit-content;}

   #newsletter_model .newsletter_box_layout{padding-right:32px;}
{% endstyle %}

{% liquid
  assign layout_position = ''
  case section.settings.layout_position
    when 'bottom_left'
      assign layout_position = 'justify-content-md-start align-items-md-end justify-content-center align-items-center'
    when 'center'
      assign layout_position = 'justify-content-center align-items-center'
    when 'bottom_right'
      assign layout_position = 'justify-content-md-end align-items-md-end justify-content-center align-items-center'
    else
      assign layout_position = 'justify-content-md-end align-items-md-end justify-content-center align-items-center'
  endcase
%}
    <div  id="newsletter_model" class="visually-hidden bg-overlay d-flex {{ layout_position }}  newsletter_overlay fixed-bottom " data-delay ={{ section.settings.cookie_modal_delay }}>
    <div class=" d-flex {{ layout_positions }} position-relative newletter_wrapper">
    <button type="button" class="btn-close position-absolute z-1 m-3 {% if section.settings.newsletter_shape == 'circle' %}  my-md-4 p-3 p-md-3 rounded-circle {% endif %}" id="close-popup">
    </button>
    <div class="popup-modal d-flex flex-column overflow-y-scroll  text-center position-relative {% if  section.settings.newsletter_shape == 'circle' %} rounded-circle {% else %} box-modal m-3 p-sm-5 p-4 {% endif %} color-{{ section.settings.color_scheme }} gradient">
    {% unless section.settings.newsletter_shape == 'circle' %}
    {% if section.settings.image %}
    <div class="newsletter_image{% if section.settings.image %} mb-sm-4 mb-2 pb-sm-2 pb-1{% endif %}">
    {{
    section.settings.image
    | image_url: width: 800
    | image_tag:
    width: section.settings.image.width,
    sizes: '(min-width: 1200px) 650px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
    widths: '320, 540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
    class: 'img-fluid w-100 h-100'
    }}
    </div>
    {% endif %}
    {% endunless %}
    <div id="confirmModal_newsletter" class="popup_content-block overflow-y-scroll h-100  p-2{% if section.settings.newsletter_shape == 'circle' %} col-9 {% endif %}"  >
    {% if section.settings.heading != blank %}
    <h2 class="{{ section.settings.heading_size }} mb-4 mx-auto {% if section.settings.newsletter_shape =="circle" %} px-md-5 px-3 {% else %} newsletter_box_layout  {% endif %}">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
    <p class="mx-auto px-md-5 px-3 px-sm-0">{{ section.settings.description }}</p>
    {% endif %}
    {% form 'customer', id: 'ContactPopup', class: 'newsletter-form' %}
    {% unless  section.settings.newsletter_shape == 'circle' %}
    <div class="form_input mb-3 w-auto text-center position-relative">
    <label for="email" class="visually-hidden"></label>
    <input
    type="email"
    class="form-control mb-3 mb-md-0 input_control"
    name="contact[email]"
    id="email"
    placeholder="{{ 'newsletter.label' | t }}"
    pattern="^([a-zA-Z0-9_\-\+\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,9})$"
    required
    >
    <button type="submit" class="btn btn-primary position-md-absolute input_button">
    <span class="d-md-inline-block text-break">{{ 'newsletter.button_label' | t }}</span
    ><span class="d-none">{% render 'icon-subscribe' %} </span>
    </button>
    </div>
    {% else %}
    <div class="form_input my-3 w-auto position-relative text-center px-sm-0 px-2 mx-4 mx-sm-0">
    <label for="email" class="visually-hidden"></label>
    <input
    type="email"
    class="form-control mb-3 mb-md-0"
    name="contact[email]"
    id="email"
    placeholder="{{ 'newsletter.label' | t }}"
    pattern="^([a-zA-Z0-9_\-\+\.]+)@([a-zA-Z0-9_\-\.]+)\.([a-zA-Z]{2,9})$"
    required
    >
    <button type="submit" class="btn btn-primary position-md-absolute input_button">
    <span class="d-md-inline-block text-break">{{ 'newsletter.button_label' | t }}</span
    ><span class="d-none">{% render 'icon-subscribe' %} </span>
    </button>
    </div>
    {% endunless %}
    <div class="newsletter-message mt-3" style="display: none;"></div>

    {% if section.settings.update != blank %}
    <div class="info d-flex align-items-baseline justify-content-center gap-2 {% if  section.settings.newsletter_shape == 'circle' %} mx-5 mx-sm-0 {% endif %}">
    <p class="form-check-label text-start text-center mb-2 px-md-5 px-3 " for="updateradio-{{ section.index }}">
    {{ section.settings.update }}
    </p>
    </div>
    {% endif %}
    {{ form.errors | default_errors }}
    {%- if form.posted_successfully? -%}
    <p class="align-items-baseline justify-content-center gap-1"><span class="text-success lh-0 me-2 d-inline-block">{% render 'icon-success' %}</span>{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {% endform %}
    </div>
    </div>
    </div>
    <div>

{% schema %}
{
  "name": "t:sections.newsletter-modal.name",
  "tag": "aside",
  "class": "newsletter-popup",
  "settings": [
     {
      "type": "paragraph",
      "content": "t:sections.newsletter-modal.settings.customer_list.content"
     },
     {
      "type": "header",
      "content": "t:sections.newsletter-modal.settings.newsletter_appear.label"
    },
    {
       "type": "range",
       "id": "cookie_expires",
       "label": "t:sections.newsletter-modal.settings.cookie_expires.label",
       "min": 1,
       "max": 30,
       "step": 1,
       "default": 1,
       "info": "t:sections.newsletter-modal.settings.cookie_expires.info"
   },
    {
       "type": "text",
       "id": "cookie_modal_delay",
       "label": "t:sections.newsletter-modal.settings.cookie_modal_delay.label",
       "default": "5000",
       "info": "t:sections.newsletter-modal.settings.cookie_modal_delay.info"
   },
    {
      "type": "select",
      "id": "layout_position",
      "label": "t:sections.newsletter-modal.settings.layout_position.label",
      "options": [
        {
          "label": "t:sections.newsletter-modal.settings.layout_position.options.option_1.label",
          "value": "bottom_left"
        },
        {
          "label": "t:sections.newsletter-modal.settings.layout_position.options.option_2.label",
          "value": "center"
        },
        {
          "label": "t:sections.newsletter-modal.settings.layout_position.options.option_3.label",
          "value": "bottom_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "newsletter_shape",
      "label": "t:sections.newsletter-modal.settings.newsletter_shape.label",
      "options": [
        {
          "label": "t:sections.newsletter-modal.settings.newsletter_shape.options__1.label",
          "value": "circle"
        },
        {
          "label": "t:sections.newsletter-modal.settings.newsletter_shape.options__2.label",
          "value": "square"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter-modal.settings.image.label",
      "visible_if": "{{ section.settings.newsletter_shape == 'square' }}"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter-modal.settings.layout_setting"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
      {
      "type":"text",
      "id":"heading",
      "label":"t:sections.newsletter-modal.settings.title.label"
    },
    {
     "type": "select",
     "id": "heading_size",
     "options": [
       {
         "value": "h3",
         "label": "t:sections.all.heading_size.options__1.label"
       },
       {
         "value": "h2",
         "label": "t:sections.all.heading_size.options__2.label"
       },
       {
         "value": "h1",
         "label": "t:sections.all.heading_size.options__3.label"
       }
     ],
     "default": "h1",
     "label": "t:sections.all.heading_size.label"
   },
  {
  "type":"text",
  "id":"description",
  "label":"t:sections.all.description.label",
  "default": "t:sections.newsletter-modal.settings.description.default",
  },
  {
      "type": "text",
      "id": "update",
      "label": "t:sections.all.footer_description.label",
      "default":"t:sections.newsletter-modal.settings.update.default"
    }
  ]
}
{% endschema %}
