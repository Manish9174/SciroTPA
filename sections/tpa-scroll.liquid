<script>
  (function () {

    var currentScript = document.currentScript;
    var shopifySection = currentScript.closest(".shopify-section");

    if (!shopifySection) return;

    var section = shopifySection.querySelector(".cherry-section");
    var bottle = shopifySection.querySelector(".cherry-bottle");

    if (!section || !bottle) return;

    var startRotation = {{ section.settings.start_rotation }};
    var straightAt = {{ section.settings.straight_at }} / 100;

    function initBottleAnimation() {

      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
        setTimeout(initBottleAnimation, 300);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      var oldTrigger = ScrollTrigger.getById("cherry-bottle-animation");

      if (oldTrigger) {
        oldTrigger.kill();
      }

      gsap.killTweensOf(bottle);

      /* Sirf rotation, x/y movement nahi */
      gsap.set(bottle, {
        rotation: startRotation,
        transformOrigin: "50% 50%"
      });

      gsap.to(bottle, {
        rotation: 0,
        ease: "none",

        scrollTrigger: {
          id: "cherry-bottle-animation",
          trigger: section,

          /* Section jaise hi screen ke neeche se dikhna shuru ho */
          start: "top bottom",

          /* Jab section ka straightAt% hissa screen par dikh jaye */
          end: function () {
            return "top " + (window.innerHeight - section.offsetHeight * straightAt) + "px";
          },

          scrub: 0.3,
          invalidateOnRefresh: true
        }
      });

      ScrollTrigger.refresh();
    }

    initBottleAnimation();

  })();
</script>
{% schema %}
{
  "name": "TPA Scroll",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Bottle image"
    },


        {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
     {
      "type": "range",
      "id": "straight_at",
      "label": "Bottle seedhi ho jab section itna % screen par dikhe",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "start_rotation",
      "label": "Bottle ka starting tilt",
      "min": -90,
