

<style>

  .spacer {
    height: 100vh;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 30px;
  }

  .cherry-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    background-image: url('https://cdn.shopify.com/s/files/1/0769/9064/4387/files/cycling-speed-men-bicycle-with-motion-blur-adrenaline-extreme-sports-generative-ai_copy.jpg?v=1789822816');
    color: white;
  }

  .cherry-container {
    position: relative;
    width: 100%;
    min-height: 700px;
    margin: auto;
    display: flex;
    align-items: center;
    padding: 80px 8%;
    
  }

  .circle-one {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: #67676773;
    left: -250px;
    top: -220px;
  }

  .circle-two {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: #67676773;
    left: 32%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .circle-three {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 35px solid #67676773;
    right: -100px;
    bottom: -150px;
  }

  .cherry-content {
    position: relative;
    z-index: 2;
    width: 60%;
  }

  .cherry-small-text {
        font-size: 1.125rem;
    color:#ffd4f6;
    margin-bottom: 15px;
    margin-top: 15px;
    line-height: 125%;
  }

  .cherry-heading {
 font-size: 4.25rem;;
    line-height: 0.95;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color:#ffffff;
    
  }

  .cherry-description {
    font-size: 14px;
    line-height: 1.5;
    max-width: 190px;
    margin-bottom: 15px;
  }

  .cherry-alcohol {
    display: inline-block;
    font-size: 12px;
    padding: 5px 7px;
    margin-bottom: 12px;
  }

  .cherry-flavor {
    font-weight: 300;
    color:#fff8b5;
    max-width: 160px;
    margin-bottom: 22px;
    font-size: 1.125rem;
    line-height: 125%;
  }

  .cherry-button {
    display: inline-block;


    background-color: #ffd4f6;
    color: hsla(7, 100%, 40%, 1.00);
    text-align: center;
    border: 1px #000;
    border-radius: 8px;
    padding: 15px 5rem;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 120%;
    text-decoration: none;


  }

  .cherry-product {
    position: absolute;
    z-index: 3;
    width: 55%;
    max-width: 650px;
    right: 2%;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

 .cherry-bottle {
    display: block;
    max-width: 50vh;
    height: auto;
    object-fit: contain;
    transform-origin: 50% 50%;
    will-change: transform;
  }

{% comment %} .cherry-bottle{

   animation: bottleFloat 3s ease-in-out infinite;
  will-change: transform;

}

@keyframes bottleFloat {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-20px);
  }

  100% {
    transform: translateY(0);
  }
} {% endcomment %}



  {% comment %} .cherry-bottle {
  animation: floatingProduct 2.5s ease-in-out infinite;
}

@keyframes floatingProduct {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-1.7rem);
  }

  100% {
    transform: translateY(0);
  }
}  {% endcomment %}




  @media (max-width: 768px) {

    .cherry-section {
      min-height: 700px;
    }

    .cherry-container {
      min-height: 700px;
      padding: 40px 20px;
      align-items: flex-start;
          flex-direction: column-reverse;
          row-gap:2rem;
    }

    .cherry-content {
      width: 100%;

      display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    }

    .cherry-small-text {
      font-size: 10px;
    }

    .cherry-heading {
      font-size: 2.75rem;

     
    letter-spacing: -2.25px;
    margin-bottom: 10px;
    font-weight: 700;
    line-height: 100%;

    }

    .cherry-description {
      font-size: 1rem;
    }

    .cherry-button {
              padding: 15px 5rem;
    }

    .cherry-product {
      position:unset;
      width: 50%;
      max-width: 180px;
      right: 50%;
      top: 40px;
      transform: translateX(50%);
    }

    .cherry-bottle {
      width:auto;
      max-width: 40vh;
      rotate:-10deg!important;
    }

    .circle-one {
      width: 300px;
      height: 300px;
      left: -180px;
      top: -150px;
    }

    .circle-two {
      width: 250px;
      height: 250px;
      left: 50%;
      top: 25%;
    }

    .circle-three {
      width: 200px;
      height: 200px;
      border-width: 25px;
      right: -100px;
      bottom: -100px;
    }
  }

</style>

