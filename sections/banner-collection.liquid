{% render 'spacing' %}
{% liquid
  assign aspect_ratio = ''
  case section.settings.blog_aspect_ratio
    when 'square'
      assign aspect_ratio = 'ratio-1x1'
    when 'portrait'
      assign aspect_ratio = 'ratio-3x4'
    when 'landscape'
      assign aspect_ratio = 'ratio-4x3'
    when 'wide'
      assign aspect_ratio = 'ratio-16x9'
    when 'adapt'
      assign aspect_ratio = 'ratio-auto'
    else
      assign aspect_ratio = 'ratio-1x1'
  endcase

  assign card_aspect_ratio = ''
  case section.settings.card_aspect_ratio
    when 'square'
      assign card_aspect_ratio = 'ratio-1x1'
    when 'portrait'
      assign card_aspect_ratio = 'ratio-3x4'
    when 'landscape'
      assign card_aspect_ratio = 'ratio-4x3'
    when 'wide'
      assign card_aspect_ratio = 'ratio-16x9'
    when 'adapt'
      assign card_aspect_ratio = 'ratio-auto'
    else
      assign card_aspect_ratio = 'ratio-1x1'
  endcase
%}

{% style %}
          .banner-section :is(.quantity-selector button){
          border: 1px solid rgba(var(--color-foreground));
          min-width: clamp(2.8125rem, 2.625rem + 0.9375vw, 3.75rem);
          min-height: clamp(2.8125rem, 2.625rem + 0.9375vw, 3.75rem);
          border-radius: 50%;
          display: inline-flex;
          justify-content: center;
          align-items: center;
          }
          .banner-section :is(.quantity-selector button > svg){
          color: rgba(var(--color-foreground));
          width: 16px;
          height: 16px;
          }
          .banner-section :is(.quantity .varinant-select select){
          background: rgba(var(--color-primary-button-bg)) !important;
          color: rgba(var(--color-primary-button-text));
          }
          .banner-section :is(input:focus-visible){ outline:0; }
          .banner-section :is(input){
          width: 100%;
          max-width: 60px;
          text-align: center;
          color: currentColor;
          background: rgba(var(--color-background));
          }
          .banner-section .divider{
            height: 1px;
          background:rgba(var(--color-foreground));
          }

          .product-container.product-container-{{ section.id }} #product-details{ max-width: 100%; }

          @media (max-width: 1199.98px) { .product-container.product-container-{{ section.id }} #product-details{ max-width: 100%; } }

          @media (max-width: 992px)  {
          .product-container.product-container-{{ section.id }} #product-details{ max-width: 100%; }
          }

          @media (max-width: 575.98px)  {
          .banner-section :is(.product__quantity-cart .quantity):before{ display:none; }
          .product-container.product-container-{{ section.id }} #product-details{ max-width: 100%; }
          .banner-section .swiper-prev, .banner-section .swiper-next{ display:none; }
          }
          .banner-section:has(.swiper:not(.swiper-initialized)) .variant-select-container select:not(:first-of-type) {display:none;}

          input#quantity[type="number"] {
          -moz-appearance: textfield;
          }
          input#quantity[type="number"]::-webkit-outer-spin-button,
          input#quantity[type="number"]::-webkit-inner-spin-button {
          -webkit-appearance: none;
          margin: 0;
          }
          /* Firefox */
          input#quantity[type="number"][type=number] {
          -moz-appearance: textfield;
          }
          .varinant-select select {
          cursor:pointer;
          }
          .varinant-select::after {
          content: '';
          mask-image:url('data:image/svg+xml,<svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M4.29289 8.29289C4.68342 7.90237 5.31658 7.90237 5.70711 8.29289L12 14.5858L18.2929 8.29289C18.6834 7.90237 19.3166 7.90237 19.7071 8.29289C20.0976 8.68342 20.0976 9.31658 19.7071 9.70711L12.7071 16.7071C12.3166 17.0976 11.6834 17.0976 11.2929 16.7071L4.29289 9.70711C3.90237 9.31658 3.90237 8.68342 4.29289 8.29289Z" fill="%23000000"/></svg>');
          width:24px;
          height:24px;
          margin:auto;
          mask-position: center;
          mask-repeat: no-repeat;
          background-color:rgb(var(--color-background));
          position: absolute;
          right: 8%;
          top: 0;
          bottom: 0;
          pointer-events: none;
          }
          .quantity-selector button{ background: var(--bs-body-bg); }
          .banner-section .product_showcase .variant-selection {
          font-weight: var(--font-body-weight-bold);
          background: rgba(var(--color-secondary-button-bg));
          display: inline-flex;
          color: rgba(var(--color-secondary-button-text));
          border-radius: var(--btn-border-radius);
          /* padding: .5em 2.2em .5em 1em; */
          border: 0;
          appearance: none;
          -webkit-appearance: none;
          position: relative;
          background-image: linear-gradient(45deg, transparent 50%,  rgba(var(--color-secondary-button-text)) 50%), linear-gradient(135deg,  rgba(var(--color-secondary-button-text)) 50%, transparent 50%), radial-gradient(#ddd 0%, transparent 0%);
          background-position: calc(100% - 20px) calc(1em + 10px), calc(100% - 15px) calc(1em + 10px), calc(100% - .5em) .5em;
          background-size: 5px 5px, 5px 5px, 1.5em 1.5em;
          background-repeat: no-repeat;
          padding:20px 20px;
          }
         .product_showcase select.variant-selection option.disabled {
          color: rgba(var(--color-foreground), 0.5);
          }
        @media screen and (min-width:576px){
         .banner-section .product_showcase .product__quantity-cart .product_price{
          max-width: 50%;
          width: 50%;
          align-items: start !important;
        }
          .banner-section .product_showcase .product__quantity-cart .quantity-selector{
          width: 50%;
          max-width: 50%;
          }
        }
        .product_showcase .variant-select-container > * {
          flex-grow: 1;
        }
        .product_showcase .quantity.row{padding:0 !important;}

        .product-container.product-container-{{ section.id }}{
          flex-direction:column;
        }
        .product-gallery-content.product-gallery-content-{{section.id }}{ width:50%; margin:auto;}
        .banner-section  .swiper-next, .banner-section .swiper-prev{
          position: absolute;
          top: 35%;
          bottom: unset;
          margin: auto;
          z-index: 100;
          }
         {% if section.settings.pagination_style == "artistic" %}
        .banner-section .swiper-next{right: -40px;}
        .banner-section .swiper-prev{left: -40px ;}
        {% else %}
        .banner-section .swiper-next{right:-20px;}
        .banner-section .swiper-prev{left: -20px ;}
        {% endif %}
        @media screen and (max-width: 991px){
        .product-gallery-content.product-gallery-content-{{section.id }}{position:relative;}
        }
        @media screen and (min-width: 576px){
        .product-gallery-content.product-gallery-content-{{section.id }}{ width:50%; margin:auto;}
        }
        @media screen and (min-width:992px){

        .product-container.product-container-{{ section.id }}{flex-direction:row; align-items:center;}
        .product-gallery-content.product-gallery-content-{{section.id }}{ width:80%; margin:auto; position:relative;}
        .product-banner-image.product-banner-image-{{section.id }}{ flex:1 1 50%;}
        .product-showcase-content.product-showcase-content-{{section.id}}{ flex:1 1 50%; width:37%; display: flex; align-items: center; padding: 0 30px;}
        .product-showcase-main-content.product-showcase-main-content-{{section.id}}{max-width:100%;}
        .collection_container{ padding-left: 0; }
        }
        @media (min-width:1200px){
          .product-banner-image.product-banner-image-{{section.id }}{ flex:1 1 60%;}
          .product-gallery-content.product-gallery-content-{{section.id }}{ width: 80%; }
            .product-showcase-content.product-showcase-content-{{section.id}}{ flex:1 1 47%; width:37%; }
        }
         @media (min-width:1400px){
         .product-showcase-content.product-showcase-content-{{section.id}} {padding: 0 100px;}
         }
        {% if section.settings.secondary_img %}
        .secondary_image{ transition:all .5s linear;}
        {% endif %}

   .product-showcase-content .card .secondary_image { opacity: 0; transition: all 0.3s linear; }
   .product-showcase-content .card:hover .secondary_image { opacity: 1; }
   .banner-section .product_showcase .variant-select-container > * {
    flex-grow: 1;
    width: 100%;
    flex-basis: 40%;
}

  @media (max-width: 479px)  {
  .product-gallery-content.product-gallery-content-{{section.id }}{ width:100%; margin:auto;}
  .banner-section .quantity_block{flex-direction:column; gap:1rem;}
  .banner-section .product__quantity-cart .variant-select-container{flex-direction:column;}
  .banner-section .product_showcase .variant-select-container > *{flex-basis:unset;}
  .product-container.product-container-{{ section.id }} #product-details{ max-width: 100%; }
  }
{% endstyle %}

{% assign currency_symbol = shop.money_format | remove: '{{amount}}' %}
<div
  class="product_showcase product_showcase-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient  {{ settings.animation_effect }}"
  data-sectionId="{{ section.id }}"
  data-space="60"
  data-currency="{{ currency_symbol }}"
  data-delay="{{ section.settings.autoplay_delay | times:1000 }}"
  data-slideCount="1"
>
  <div class="collection_container {% if section.settings.full_width %}container-fluid{% else %}container-sm gx-5 gx-sm-4{% endif %}">
    {% render 'title-container' %}
    <div class="product-container product-container-{{ section.id }} d-flex align-items-stretch">
      <div class="product-banner-image product-banner-image-{{section.id }}">
        <div class="sticky-md-top h-100">
          <div
            class="h-100 ratio {{ aspect_ratio }}"
            {% if section.settings.blog_aspect_ratio == 'adapt' %}
              style="--aspect-ratio:{% if section.settings.image.aspect_ratio %}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100  }}{% else %}100{% endif %}%;"
            {% endif %}
          >
            {% if section.settings.image %}
              {{
                section.settings.image
                | image_url: width: 800
                | image_tag: class: 'img-fluid w-100 h-100 object-fit-cover'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg h-100' }}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="py-5 product-showcase-content product-showcase-content-{{section.id}}">
        <div class="product-showcase-main-content product-showcase-main-content-{{section.id}}">
          <div class="product-gallery-content product-gallery-content-{{section.id }} text-{{ section.settings.text_alignment }}">
            {% if section.settings.collection != blank %}
              <div
                class="swiper product_showcase-swiper-{{ section.id }}"
                {% if settings.animation != 'none' %}
                  data-aos="{{ settings.animation}}"
                {% endif %}
              >
                <div class="swiper-wrapper product_showcase">
                  {%- assign first_available_product = section.settings.collection.products
                    | where: 'available', true
                    | first
                  -%}
                  {%- for product in section.settings.collection.products -%}
                    {%- if product.available -%}
                      <div
                        class="swiper-slide {{ settings.animation_effect }}"
                        data-productid="{{ product.id }}"
                        data-producthandle="{{ product.handle }}"
                        tabindex="-1"
                      >
                        {%- if product.featured_media -%}
                          {%- assign loading = 'lazy' -%}
                        {% endif %}
                        {%- if product.id == first_available_product.id -%}
                          {%- assign loading = 'eager' -%}
                        {%- endif -%}
                        <div class="card">
                          {% if product.featured_media %}
                            <div
                              class="card-img ratio {{ card_aspect_ratio }}"
                              {% if section.settings.card_aspect_ratio == 'adapt' %}
                                style="--aspect-ratio:{% if product.featured_media.card_aspect_ratio %}{{ 1 | divided_by: product.featured_media.card_aspect_ratio | times: 100  }}{% else %}100{% endif %}%;"
                              {% endif %}
                            >
                              <a href="{{ product.url }}" tabindex="-1">
                                {{
                                  product.featured_media
                                  | image_url: width: 1280
                                  | image_tag:
                                    aria_hidden: 'true',
                                    loading: loading,
                                    width: product.featured_media.width,
                                    height: product.featured_media.height,
                                    sizes: '(min-width: 1200px) 600px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                                    class: 'product-image img-fluid card_product_detail w-100 border-none ',
                                    alt: product.featured_media.alt
                                  | escape
                                -}}
                                {% if product.media[1] != null and section.settings.secondary_img %}
                                  {{
                                    product.media[1]
                                    | image_url: width: 1280
                                    | image_tag:
                                      aria_hidden: 'true',
                                      loading: 'lazy',
                                      width: product.media[1].width,
                                      height: product.media[1].height,
                                      sizes: '(min-width: 1200px) 650px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                                      widths: '320, 540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                                      class: 'img-fluid secondary_image card_product_detail border-none w-100',
                                      alt: product.media[1].alt
                                    | default: product.title
                                    | escape
                                  }}
                                {% endif %}
                              </a>
                            </div>

                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                          <div class="card-body">
                            {% if section.settings.show_vendor %}
                              <div class="vendor">
                                <span class="mb-0">{{ product.vendor }}</span>
                              </div>
                            {% endif %}
                            <h3 class="pro_title mb-0">{{ product.title }}</h3>
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {%- endfor -%}
                </div>
              </div>
              <div>
                <div class="swiper-prev main-prev product_showcase_prev-{{ section.id }} rounded-0 {% if section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
                  {% render 'arrow-left' %}
                </div>
                <div class="swiper-next main-next product_showcase_next-{{ section.id }} rounded-0 {% if section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
                  {% render 'arrow-right' %}
                </div>
              </div>

            {% else %}
              <div
                class="swiper product_showcase-swiper-{{ section.id }}"
                {% if settings.animation != 'none' %}
                  data-aos="{{ settings.animation}}"
                {% endif %}
              >
                <div class="swiper-wrapper">
                  {% for i in (1..6) %}
                    <div class="swiper-slide">
                      {%- assign placeholder_image_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                      {%- assign placeholder_image = 'product-' | append: placeholder_image_index -%}
                      <div
                        class="placeholder-image ratio {{ card_aspect_ratio }} mb-3"
                        {% if section.settings.card_aspect_ratio == 'adapt' %}
                          style="--aspect-ratio:{% if product.featured_media.card_aspect_ratio %}{{ 1 | divided_by: product.featured_media.card_aspect_ratio | times: 100  }}{% else %}100{% endif %}%;"
                        {% endif %}
                      >
                        {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg card_product_detail' }}
                      </div>
                      <h3 class="pro_title mt-4">{{ 'onboarding.product_title' | t }}</h3>
                    </div>
                  {% endfor %}
                </div>
                {% if section.settings.pagination == 'arrow' %}
                  <div>
                    <div class="swiper-next main-next product_showcase_next-{{ section.id }} rounded-0">
                      {% render 'arrow-right' %}
                    </div>
                    <div class="swiper-prev main-prev product_showcase_prev-{{ section.id }} rounded-0">
                      {% render 'arrow-left' %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
          <div id="product-details" class="m-auto mt-0 pt-0 w-100">
            <form
              method="post"
              action="{{ routes.cart_url }}/add"
              accept-charset="UTF-8"
              class="showcase-add-to-cart-form product-showcaseform product-options-form product-summary__product-options-form"
              enctype="multipart/form-data"
              data-sectionid="{{ section.id }}"
              novalidate="novalidate"
            >
              <input type="hidden" name="form_type" value="product"><input type="hidden" name="utf8" value="✓">

              <div class="product__quantity-cart">
                <div class="quantity row row-cols-sm-2 row-gap-3 row-sm-gap-4 w-100 mx-auto">
                  <div class="align-items-center align-items-sm-end d-flex flex-column flex-wrap gap-2 justify-content-start product_price text-sm-start ps-0">
                    <div class="d-flex flex-wrap flex-xxl-wrap align-items-end justify-content-center justify-content-sm-start  gap-2">
                      <div class="price d-flex gap-2 align-items-end">
                        <h4 class="pro_price h4 m-0 text-nowrap">{{ 'sections.cart.price' | t }}</h4>
                        <span class="mb-0">
                          {%- if settings.currency_code_enabled %}{{ cart.currency.iso_code }}{% endif -%}
                        </span>
                      </div>
                      <div class="product_compare_price d-flex gap-1 flex-column align-items-start">
                        <div class="compare_price d-flex gap-2 align-items-end">
                          <p class="cmp_price m-0 text-decoration-line-through"></p>
                          <span class="mb-0">
                            {%- if settings.currency_code_enabled  %}{{ cart.currency.iso_code }}{% endif -%}
                          </span>
                        </div>
                      </div>
                    </div>



                    <p class="pro_profit m-0"></p>
                  </div>
                  <div class="quantity-selector position-relative text-sm-end d-flex align-items-center justify-content-center justify-content-sm-end">
                    <label for="quantity" class="visually-hidden">{{ 'products.product.quantity.label' | t }}</label>
                    <button
                      type="button"
                      id="decrement"
                      class="quantity-btn"
                      name="minus"
                      aria-label="{{ 'accessibility.decrement' | t }}"
                    >
                      {% render 'icon-minus' %}
                    </button>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" class="border-0 h5 mb-0">
                    <button
                      type="button"
                      id="increment"
                      class="quantity-btn"
                      name="plus"
                      aria-label="{{ 'accessibility.increment' | t }}"
                    >
                      {% render 'icon-plus' %}
                    </button>
                  </div>
                  <div class="divider w-100"></div>
                  <div class="variant-select-container w-100 position-relative d-flex align-items-center justify-content-between gap-2 flex-wrap p-0">
                    <input
                      id="variant-selectitem-{{ section.id }}"
                      class="variant-select"
                      aria-label="variant"
                      name="id"
                      hidden
                    >
                    {%- for product in section.settings.collection.products -%}
                      {%- if product.available -%}
                        {% for option in product.options_with_values %}
                          <label for="variant-select-{{ product.id }}" class="mb-3 h4 visually-hidden">
                            {{- option.name }}:</label
                          >
                          <select
                            class="variant-selection form-select-lg text-uppercase btn"
                            id="variant-select-{{ product.id }}"
                            name="variant"
                            data-producthandle="{{  product.handle }}"
                            data-sectionId="{{ section.id }}"
                          >
                            {% for value in option.values %}
                              <option
                                data-id="{{ value.id }}"
                                data-value="{{ value.id }}"
                                value="{{ value.id }}"
                                class="{% if value.available %} available {% else %}disabled{% endif %}"
                                data-available="{% if value.available %} available {% else %} Sold out {% endif %}"
                                data-price="{{ product.price | money }}"
                              >
                                {{ value }}
                              </option>
                            {% endfor %}
                          </select>
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                     <div class="p-0">
                    <button
                      type="submit"
                      class="add-to-cart-button {% if section.settings.collection.products.size > 1 %}available {% else %}disabled {% endif %} btn btn-primary rounded-pill w-100 h-100"
                      disabled
                    >
                      {% if section.settings.collection.products.size > 1 %}
                        {{ 'general.card.add_to_cart' | t }}
                      {% else %}
                        {{ 'products.product.sold_out' | t }}
                      {% endif %}
                    </button>
                  </div>
                  </div>

                </div>
              </div>
              <input type="hidden" class="product-id" name="product-id">
              <input type="hidden" name="section-id" value="{{ section.id }}">
              <div class="showcase-message"></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% assign currency_symbol = shop.money_format | remove: '{{amount}}' %}

{% schema %}
{
  "name": "t:sections.banner-collection.name",
  "tag": "section",
  "class": "banner-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "default": "t:sections.banner-collection.settings.title.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "description",
      "default": "t:sections.all.content_description.default",
      "label": "t:sections.all.description.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.content_alignment.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "info": "1400 x 900px recommended"
    },
    {
      "type": "select",
      "id": "blog_aspect_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__4.label"
        }
      ],
      "default": "square",
      "label": "t:settings_schema.card.settings.card_aspect_ratio.label"
    },
    {
      "type": "header",
      "content": "t:settings_schema.colors.settings.headers.layout"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.product-showcase.settings.collection_list.label"
