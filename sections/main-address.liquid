          {% endform %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script> 
function initializeAddressHandlers() { 
    document.querySelectorAll(".address_countrySelect").forEach(function (select) {
        let defaultCountry = select.getAttribute("data-default");
        if (defaultCountry) {
            select.value = defaultCountry;
        }
    });
     
    $(document).on('click', '.address_countryEdit', function(){
        $(this).remove();
        $('.address_countrySelect').removeClass('d-none');
        $('.address_provinceEdit').remove();
    });
    $(document).on('click', '.addnew_address', function(){
      
          $('.address_details').removeClass('d-none');
          $('.address_details').toggle();
   });
     
    $(document).on('click', '.editaddress_button', function() {
       $('.edit_address').removeClass('d-none')
        $('.edit_address').hide();
        var addressid = $(this).data('address-id'); 
        $('#edit_address-'+addressid).show();
    });
     
    var addressSelectors = document.querySelectorAll('select[name="address[country]"]');
    addressSelectors.forEach(function(select) {
        countrySelectionHandler(select);
         
        select.addEventListener('change', function(){
            countrySelectionHandler(select);
        });
    });
     
    $(document).on('click', '.delete-address-button', function() {
        var target = $(this).data('target');
        var confirmMessage = $(this).data('confirm-message');
        
        if (confirm(confirmMessage)) {
            fetch(target, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin'
            }).then(function(response) {
                window.location.reload();
            }).catch(function(error) {
              
                alert('An error occurred while deleting the address');
            });
        }
    });
}
 
function countrySelectionHandler(select) {
    var selectedValue = select.value || select.dataset.default;
    var countryProvincesSelect = select.closest('form').querySelector('select[name="address[province]"]');
    
    if (!countryProvincesSelect) {
        
        return;  
    }
    
    countryProvincesSelect.innerHTML = ''; 
    
    for (let i = 0; i < select.children.length; i++) {
        var option = select.children[i];
        if (option.value === selectedValue) {
            var countryProvinces = JSON.parse(option.dataset.provinces); 
           // console.log("countryProvinces", countryProvinces);
            
            if (countryProvinces && countryProvinces.length > 0) {
                var label = countryProvincesSelect.closest('label');
                if (label) {
                    label.classList.add('active');  
                }
                 
                countryProvinces.forEach(province => {
                    var newOption = document.createElement("option");
                    newOption.text = province[1];
                    newOption.value = province[0];
                    countryProvincesSelect.add(newOption);
                });
                countryProvincesSelect.classList.remove('d-none'); 
                countryProvincesSelect.classList.add('d-block');
            } else {
                countryProvincesSelect.classList.add('d-none');
                var label = countryProvincesSelect.closest('label');
                if (label) {
                    label.classList.remove('active');  
                } 
                countryProvincesSelect.innerHTML = '';
            }
            break;  
        }
    }
}
 
document.addEventListener('DOMContentLoaded', initializeAddressHandlers); 
if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
        initializeAddressHandlers();
    });
    
    document.addEventListener('shopify:section:unload', function(event) { 
    });
}
 
setTimeout(initializeAddressHandlers, 100);
</script>

