{% render 'spacing' %}

{% liquid
  assign count = 0
  for collection in section.settings.collection_list
    assign count = count | plus: 1
  endfor
%}
{% liquid
  # Determine the aspect ratio for the card
  assign aspect_ratio = ''
  case section.settings.grid_image_ratio
    when 'square'
      assign aspect_ratio = 'ratio-1x1'
    when 'portrait'
      assign aspect_ratio = 'ratio-3x4'
    when 'landscape'
      assign aspect_ratio = 'ratio-4x3'
    when 'wide'
      assign aspect_ratio = 'ratio-16x9'
    when 'adapt'
      assign aspect_ratio = 'ratio-auto'
    else
      assign aspect_ratio = 'ratio-1x1'
  endcase


  assign border = settings.collection_border
  assign radius = settings.collection_card_radius


  assign show_desktop_slider = false
  if section.settings.enable_slider
    assign show_desktop_slider = true
    assign auto_play = section.settings.autoplay_delay
    assign centered_mode = false
    assign loop_slide = false
    assign dots = section.settings.swiper_pagination
    assign space = section.settings.space | default: 0
  endif

  assign slider_desktop = section.settings.desktop_column
  assign slider_laptop = section.settings.desktop_column | minus: 1
 if slider_desktop == '1'
    assign slider_laptop = 1
    assign slider_tablet = 1
  elsif slider_desktop == '2'
    assign slider_laptop = 2
    assign slider_tablet = 2
  elsif slider_desktop == '3'
    assign slider_laptop = 2
    assign slider_tablet = 2
  elsif slider_desktop == '4'
    assign slider_laptop = 3
    assign slider_tablet = 2
  elsif slider_desktop == '5'
    assign slider_laptop = 3
    assign slider_tablet = 2
  elsif slider_desktop == '6'
    assign slider_laptop = 3
    assign slider_tablet = 3
  endif
  assign slider_mobile = 1

 assign column_size = section.blocks.size
%}



{% render 'swiper-initialization', space: space, slider_desktop: slider_desktop %}



{%- capture column_options -%}
  row-cols-{{ slider_mobile }} row-cols-md-{{  slider_tablet }} row-cols-lg-{{ slider_laptop }} row-cols-xl-{{ slider_desktop }}
{%- endcapture -%}

{%- capture slider_options -%}
 mobile-{{ slider_mobile }} tablet-{{  slider_tablet }} laptop-{{ slider_laptop }} desktop-{{ slider_desktop }}
{%- endcapture -%}
{% style %}
    .collection-item .card_img {
      position: relative;
    }
  {% if section.settings.block_styles == 'overlay' %}
   .collection-list-{{ section.id }} .collection-item .card_img::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      left: 0;
      top: 0;
      z-index:3;
     background: rgba(var(--color-background), {{section.settings.overlay }});
     border-radius: var(--bs-radius) !important;
     pointer-events:none;
    }
  {% endif %}
  .collection_list .card_img svg{ width:100%;height:100%; }
  .collections-list .collection-item :is(.card-title){
      scrollbar-width: thin;
  }
  .collections-list.collection-list-{{ section.id }} .overlay :is(.card_img, .card-body){ grid-area: 1 / -1; position:relative; }
{% endstyle %}

<div class="section-{{ section.id }} collections-list collection-list-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container gx-20 {% endif %}">
    {% render 'title-container' %}

    {% if show_desktop_slider %}
      <collection-list-slide>
        <div
          data-slider-options='
            {
                "desktop": "{{ slider_desktop }}",
                "laptop": "{{ slider_laptop }}",
                "tablet": "{{ slider_tablet }}",
                "mobile": "{{ slider_mobile }}",
                "loop": "{{ loop_slide }}",
                "mode": "{{ centered_mode }}",
                "auto_play": "{{ auto_play }}",
                "dots": "{{ dots }}",
               "space": "{{ space }}"
            }
          '
        >
    {% endif %}
    <div
        {% if show_desktop_slider %}
          class="swiper position-relative collection_list-{{ section.id }}" data-swiper-slider
        {% else %}
          class="row {{ column_options }} g-3 position-relative"
        {% endif %}
         {% if settings.animation != 'none' %} data-aos="{{ settings.animation}}"{% endif %}
      >
 {% if show_desktop_slider %}<div class="swiper-wrapper">{% endif %}
    {% if section.settings.collection_list != blank %}
   {% for collection in section.settings.collection_list %}
         <div class="{% if show_desktop_slider %}swiper-slide h-auto {{ slider_options }}  collection_list-{{ section.id }} {% else %}col{% endif %} collection-item position-relative" {{ block.shopify_attributes }}>
              <div class="collection__card card {% if section.settings.grid_image_ratio != 'adapt' %} h-100 {% endif %} color-{{ settings.collection_card_background }} {% if section.settings.block_styles == 'overlay' %} d-grid overlay{% endif %} {% if settings.collection_card_align == "card" %} collection_card{% else %} bg-transparent{% endif %}">
                <div
                  class="card_img  ratio {{ aspect_ratio }}"
                  style="--aspect-ratio:{% if collection.image %} {{ 1 | divided_by: collection.image.aspect_ratio | times: 100 }}{% elsif collection.products.first.featured_media %} {{ 1 | divided_by: collection.products.first.featured_media.aspect_ratio | times: 100 }}{% else %}100{% endif %}%;"
                >
                  <a href="{{ routes.collections_url }}/{{ collection.handle }}" class="card-img z-2  {% if settings.collection_card_align == "standard" %}collection_card{% endif %}">
                    {% if collection.image %}
                      {{
                        collection.image
                        | image_url: width: 2560
                        | image_tag:
                          aria_hidden: 'true',
                          loading: 'lazy',
                          width: collection.image.width,
                          height: collection.image.height,
                          class: 'img-fluid w-100',
                          alt: collection.image.alt
                        | escape
                      }}
                    {% elsif collection.products.first.featured_media %}
                      {{
                        collection.products.first.featured_media
                        | image_url: width: 2560
                        | image_tag:
                          aria_hidden: 'true',
                          loading: 'lazy',
                          width: collection.products.first.featured_media.width,
                          height: collection.products.first.featured_media.height,
                          class: 'img-fluid w-100',
                          alt: collection.title
                        | escape
                      }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                </div>
                <div class="card-body{% if section.settings.block_styles == 'overlay' %} card-img-overlay d-flex flex-column justify-content-end h-100 z-3 pointer-events-none{% endif %}{% if settings.collection_text_align == "center" %} text-center{% elsif settings.collection_text_align == "right" %} text-end{% endif %}{% if settings.collection_card_align != "card" and section.settings.block_styles != 'overlay' %} px-0{% endif %}">
                  <h2 class="card-title lh-1 mb-0 ">
                    <a
                      href="{{ routes.collections_url }}/{{ collection.handle }}"
                      class="text-decoration-none {{ settings.collection_card_text_size }}"
                    >
                      {{ collection.title | escape }}
                    </a>
                  </h2>
                  {% if section.settings.collection_item %}
                    <p class="m-0">
                      {{ collection.products_count }}
                      {{ 'sections.main-colletion.products' | t }}
                    </p>
                  {% endif %}
                </div>
              </div>
         </div>
 {% endfor %}
{% else %}
   {%- for i in (1..section.settings.desktop_column) -%}
    <div class="{% if show_desktop_slider %}swiper-slide h-auto {{ slider_options }} {% else %}col{% endif %} collection__card card h-100 collection-item ">
   <div class="collection__card card h-100 color-{{ settings.collection_card_background }} {% if section.settings.block_styles == 'overlay' %} d-grid overlay{% endif %} {% if settings.collection_card_align == "card" %} collection_card{% else %} bg-transparent{% endif %}">
      <div
    class="card_img ratio {{ aspect_ratio }} {% if settings.collection_card_align != "card" %} collection_card{% endif %}"
    style="--aspect-ratio:100%;"
    >
    {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
    {%- assign placeholder_image = 'collection-' | append: placeholder_image_index -%}
    {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg position-absolute' }}
    </div>
    <div class="card-body {% if section.settings.block_styles == 'overlay' %} card-img-overlay d-flex flex-column justify-content-end h-100 z-3{% endif %} {% if settings.collection_text_align == "center" %} text-center{% elsif settings.collection_text_align == "right" %} text-end{% endif %}{% if settings.collection_card_align != "card" and section.settings.block_styles != 'overlay' %} px-0{% endif %}">
    <h3 class="h5 mb-0">
    {{ 'onboarding.collection' | t }}
    </h3>
    </div>
  </div>
    </div>
    {% endfor %}
  {% endif %}
 {% if show_desktop_slider %}</div>{% endif %}
 {% if show_desktop_slider -%}
         {% assign swiper_class = 'collection_list-' | append: section.id %}
        {% if section.settings.pagination == 'dots' %}
          <div class="pagination mt-4">
          {% render 'pagination-styles', swiper-class: swiper_class %}
          </div>
        {% elsif section.settings.pagination == 'arrow' %}
          <div class="d-flex justify-content-center gap-5 my-carousel__actions mx-auto  py-1 position-relative mt-4">
            <div class="swiper-prev swiper-prev-{{ section.id }} main-prev d-inline-flex bottom-0 z-3 m-0 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
              {% render 'arrow-left' %}
            </div>
            <div class="swiper-next swiper-next-{{ section.id }} main-next z-3 m-0  d-inline-flex bottom-0 {% if section.settings.pagination == 'arrow' and section.settings.pagination_style != 'artistic' %} bg-arrow-style {% endif %}">
              {% render 'arrow-right' %}
            </div>
          </div>
        {% endif %}
      {% endif %}
 </div>
         {% if section.settings.show_view_all and count < collections.size %}
          <div class="view_all_btn text-center mt-5 ">
            <a href="{{ routes.collections_url }}" class="btn btn-primary">
              {{- 'sections.blogs.article.view_all' | t }}
            </a>
          </div>
        {% endif %}
     {% if show_desktop_slider %}
      </div>
     </collection-list-slide>
    {% endif %}
  </div>
</div>


{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section-collection-list",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "description",
      "default": "t:sections.all.content_description.default",
      "label": "t:sections.all.description.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.label"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "limit": 10,
      "label": "t:sections.collection-list.settings.collection_list.label"
    },
    {
      "type": "select",
      "id": "desktop_column",
      "options": [
        {
          "value": "2",
          "label": "t:sections.all.column_option.desktop.options__2.label"
        },
        {
          "value": "3",
          "label": "t:sections.all.column_option.desktop.options__3.label"
        },
        {
          "value": "4",
          "label": "t:sections.all.column_option.desktop.options__4.label"
        },
        {
          "value": "5",
          "label": "t:sections.all.column_option.desktop.options__5.label"
        }
      ],
      "default": "4",
      "label": "t:sections.all.column_option.desktop.label"
    },
    {
      "type": "select",
      "id": "block_styles",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.collection-list.settings.block_styles.options__1.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.collection-list.settings.block_styles.options__2.label"
        }
      ],
      "default": "grid",
      "label": "t:sections.collection-list.settings.block_styles.label"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 0.9,
      "step": 0.1,
      "default": 0.5,
      "label": "t:sections.collection-list.settings.overlay.label",
      "visible_if": "{{ section.settings.block_styles == 'overlay' }}"
    },
    {
      "type": "select",
      "id": "grid_image_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:sections.all.ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.ratio.options__4.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.all.ratio.label"
    },
    {
      "type": "checkbox",
      "id": "collection_item",
      "label": "t:sections.collection-list.settings.collection_item.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.collection-list.settings.show_view_all.label",
      "info": "t:sections.collection-list.settings.show_view_all.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.swiper.heading"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "t:sections.all.swiper.swiper_slider_enable"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.all.pagination.label",
      "visible_if": "{{ section.settings.enable_slider }}",
      "default": "arrow",
      "options": [
        {
          "label": "t:sections.all.pagination.option_1.label",
          "value": "dots"
        },
        {
          "label": "t:sections.all.pagination.option_2.label",
          "value": "arrow"
        },
        {
          "label": "t:sections.all.pagination.option_3.label",
          "value": "none"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.all.pagination_style.label",
      "visible_if": "{{ section.settings.enable_slider and section.settings.pagination != 'none' }}",
      "default": "artistic",
      "options": [
        {
          "label": "t:sections.all.pagination_style.option_1.label",
          "value": "artistic"
        },
        {
          "label": "t:sections.all.pagination_style.option_2.label",
          "value": "bold"
        },
        {
          "label": "t:sections.all.pagination_style.option_3.label",
          "value": "regular"
        }
      ]
    },
   {
      "type": "range",
      "id": "autoplay_delay",
      "min": 0,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 0,
      "label": "t:sections.all.swiper.autoplay",
      "info":  "t:sections.all.swiper.info",
      "visible_if": "{{ section.settings.enable_slider == true }}"
    },
    {
      "type": "range",
      "id": "space",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.swiper.space",
      "default": 20,
      "visible_if": "{{ section.settings.enable_slider == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing.spacing_heading"
    },
    {
      "type": "range",
      "id": "top_space",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.spacing.top_space",
      "default": 140
    },
    {
      "type": "range",
      "id": "bot_space",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.spacing.bot_space",
      "default": 140
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name"
    }
  ]
}
{% endschema %}
