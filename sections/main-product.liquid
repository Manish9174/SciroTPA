<script>
(function () {

  var galleryId =
    'variant-gallery-' +
    '{{ section.id }}';

  var selectedPackaging = null;
  var currentMedia = [];
  var currentIndex = 0;
  var swiperInstance = null;
  var lastGalleryElement = null;
  var updateTimer = null;

  var mediaData = [
    {% for media in product.media %}
      {
        id: {{ media.id | json }},
        type: {{ media.media_type | json }},
        alt: {{ media.alt | default: '' | json }},
        image: {% if media.preview_image %}
          {{ media.preview_image | image_url: width: 1600 | json }}
        {% else %}
          null
        {% endif %},
        thumb: {% if media.preview_image %}
          {{ media.preview_image | image_url: width: 300 | json }}
        {% else %}
          null
        {% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  function normalize(value) {
    return String(value || '')
      .trim()
      .toLowerCase();
  }

  function getGallery() {
    return document.getElementById(
      galleryId
    );
  }

  function getMediaKey() {
    return currentMedia
      .map(function (media) {
        return String(media.id);
      })
      .join(',');
  }

  function getFilteredMedia() {

    if (!selectedPackaging) {
      return mediaData.slice();
    }

    var selected =
      normalize(
        selectedPackaging
      );

    var filtered =
      mediaData.filter(
        function (media) {

          return normalize(
            media.alt
          ) === selected;

        }
      );

    if (filtered.length) {
      return filtered;
    }

    return mediaData.slice();
  }

  function createImage(media) {

    if (!media.image) {
      return null;
    }

    var img =
      document.createElement(
        'img'
      );

    img.src =
      media.image;

    img.alt =
      media.alt || '';

    img.loading =
      'lazy';

    img.draggable =
      false;

    return img;
  }

  function createSlides() {

    var slides = [];

    currentMedia.forEach(
      function (media) {

        var slide =
          document.createElement(
            'div'
          );

        slide.className =
          'swiper-slide';

        slide.setAttribute(
          'data-media-id',
          media.id
        );

        var image =
          createImage(
            media
          );

        if (image) {
          slide.appendChild(
            image
          );
        }

        slides.push(
          slide
        );

      }
    );

    return slides;
  }

  function renderThumbnails() {

    var gallery =
      getGallery();

    if (!gallery) {
      return;
    }

    var thumbList =
      gallery.querySelector(
        '.variant-gallery__thumb-list'
      );

    if (!thumbList) {
      return;
    }

    var existingIds = [];

    Array.prototype.forEach.call(
      thumbList.children,
      function (button) {

        existingIds.push(
          button.getAttribute(
            'data-media-id'
          )
        );

      }
    );

    var newIds =
      currentMedia.map(
        function (media) {
          return String(
            media.id
          );
        }
      );

    var sameStructure =
      existingIds.length ===
        newIds.length &&
      existingIds.every(
        function (id, index) {
          return id ===
            newIds[index];
        }
      );

    if (!sameStructure) {

      thumbList.innerHTML =
        '';

      currentMedia.forEach(
        function (
          media,
          index
        ) {

          var button =
            document.createElement(
              'button'
            );

          button.type =
            'button';

          button.className =
            'variant-gallery__thumb';

          button.setAttribute(
            'data-media-id',
            media.id
          );

          button.setAttribute(
            'data-index',
            index
          );

          button.setAttribute(
            'aria-label',
            'View image ' +
              (index + 1)
          );

          if (media.thumb) {

            var img =
              document.createElement(
                'img'
              );

            img.src =
              media.thumb;

            img.alt =
              media.alt || '';

            img.loading =
              'lazy';

            img.draggable =
              false;

            button.appendChild(
              img
            );

          }

          thumbList.appendChild(
            button
          );

        }
      );

    }

    Array.prototype.forEach.call(
      thumbList.children,
      function (
        button,
        index
      ) {

        button.classList.toggle(
          'is-active',
          index === currentIndex
        );

      }
    );

    var activeThumb =
      thumbList.querySelector(
        '.variant-gallery__thumb.is-active'
      );

    if (activeThumb) {

      var thumbWindow =
        gallery.querySelector(
          '.variant-gallery__thumb-window'
        );

      if (thumbWindow) {

        if (window.innerWidth <= 767) {

          var thumbLeft =
            activeThumb.offsetLeft;

          var thumbRight =
            thumbLeft +
            activeThumb.offsetWidth;

          var windowLeft =
            thumbWindow.scrollLeft;

          var windowRight =
            windowLeft +
            thumbWindow.clientWidth;

          if (
            thumbLeft <
            windowLeft
          ) {

            thumbWindow.scrollTo({
              left: thumbLeft,
              behavior: 'smooth'
            });

          } else if (
            thumbRight >
            windowRight
          ) {

            thumbWindow.scrollTo({
              left:
                thumbRight -
                thumbWindow.clientWidth,
              behavior: 'smooth'
            });

          }

        } else {

          var thumbTop =
            activeThumb.offsetTop;

          var thumbBottom =
            thumbTop +
            activeThumb.offsetHeight;

          var windowTop =
            thumbWindow.scrollTop;

          var windowBottom =
            windowTop +
            thumbWindow.clientHeight;

          if (
            thumbTop <
            windowTop
          ) {

            thumbWindow.scrollTo({
              top: thumbTop,
              behavior: 'smooth'
            });

          } else if (
            thumbBottom >
            windowBottom
          ) {

            thumbWindow.scrollTo({
              top:
                thumbBottom -
                thumbWindow.clientHeight,
              behavior: 'smooth'
            });

          }

        }

      }

    }

  }

  function renderMain() {

    var gallery =
      getGallery();

    if (
      !gallery ||
      !currentMedia.length
    ) {
      return;
    }

    var swiperElement =
      gallery.querySelector(
        '.variant-gallery__swiper'
      );

    var swiperWrapper =
      gallery.querySelector(
        '.variant-gallery__swiper .swiper-wrapper'
      );

    if (
      !swiperElement ||
      !swiperWrapper
    ) {
      return;
    }

    if (
      typeof Swiper ===
      'undefined'
    ) {
      return;
    }

    var newMediaKey =
      getMediaKey();

    var existingSwiper =
      swiperElement.swiper;

    if (existingSwiper) {

      var oldMediaKey =
        swiperElement.getAttribute(
          'data-swiper-media-key'
        );

      if (
        oldMediaKey ===
        newMediaKey
      ) {

        if (
          existingSwiper.activeIndex !==
          currentIndex
        ) {

          existingSwiper.slideTo(
            currentIndex,
            400
          );

        }

        swiperInstance =
          existingSwiper;

        renderThumbnails();

        return;

      }

      var slides =
        createSlides();

      swiperWrapper.innerHTML =
        '';

      slides.forEach(
        function (slide) {

          swiperWrapper.appendChild(
            slide
          );

        }
      );

      existingSwiper.update();

      if (
        currentIndex >=
        currentMedia.length
      ) {

        currentIndex =
          0;

      }

      existingSwiper.slideTo(
        currentIndex,
        0
      );

      swiperElement.setAttribute(
        'data-swiper-media-key',
        newMediaKey
      );

      swiperInstance =
        existingSwiper;

      lastGalleryElement =
        gallery;

      renderThumbnails();

      return;

    }

    var newSlides =
      createSlides();

    swiperWrapper.innerHTML =
      '';

    newSlides.forEach(
      function (slide) {

        swiperWrapper.appendChild(
          slide
        );

      }
    );

    swiperInstance =
      new Swiper(
        swiperElement,
        {

          slidesPerView: 1,

          spaceBetween: 0,

          speed: 400,

          allowTouchMove: true,

          simulateTouch: true,

          grabCursor: true,

          observer: true,

          observeParents: true,

          on: {

            slideChange:
              function () {

                currentIndex =
                  this.activeIndex;

                renderThumbnails();

              },

            slideChangeTransitionEnd:
              function () {

                currentIndex =
                  this.activeIndex;

                renderThumbnails();

              }

          }

        }
      );

    swiperInstance.slideTo(
      currentIndex,
      0
    );

    swiperElement.setAttribute(
      'data-swiper-media-key',
      newMediaKey
    );

    lastGalleryElement =
      gallery;

    renderThumbnails();

  }

  function render() {

    currentMedia =
      getFilteredMedia();

    if (!currentMedia.length) {
      return;
    }

    if (
      currentIndex >=
      currentMedia.length
    ) {

      currentIndex =
        0;

    }

    renderMain();

    renderThumbnails();

  }

  function scheduleGalleryUpdate(
    delay
  ) {

    clearTimeout(
      updateTimer
    );

    updateTimer =
      setTimeout(
        function () {

          render();

        },
        delay || 0
      );

  }

  function handlePackagingClick(
    event
  ) {

    var packaging =
      event.target.closest(
        '.option-item.custpack'
      );

    if (!packaging) {
      return;
    }

    var value =
      packaging.getAttribute(
        'data-swatch'
      );

    if (!value) {

      var title =
        packaging.querySelector(
          '.packaging-variant__title'
        );

      if (title) {

        value =
          title.textContent.trim();

      }

    }

    if (!value) {
      return;
    }

    selectedPackaging =
      value;

    currentIndex =
      0;

    scheduleGalleryUpdate(
      300
    );

  }

  function handleVariantChange(
    event
  ) {

    if (
      !event.target.matches(
        '.variant-selection'
      )
    ) {
      return;
    }

    var variants =
      event.target.closest(
        '.variants'
      );

    if (!variants) {
      return;
    }

    var label =
      variants.querySelector(
        'label'
      );

    if (!label) {
      return;
    }

    if (
      normalize(
        label.textContent
      ) !==
      'packaging:'
    ) {
      return;
    }

    var option =
      event.target.options[
        event.target.selectedIndex
      ];

    if (!option) {
      return;
    }

    selectedPackaging =
      option.textContent.trim();

    currentIndex =
      0;

    scheduleGalleryUpdate(
      300
    );

  }

  function handleClick(
    event
  ) {

    var thumb =
      event.target.closest(
        '.variant-gallery__thumb'
      );

    if (thumb) {

      var gallery =
        thumb.closest(
          '.variant-gallery'
        );

      if (!gallery) {
        return;
      }

      var index =
        parseInt(
          thumb.getAttribute(
            'data-index'
          ),
          10
        );

      if (
        isNaN(index)
      ) {
        return;
      }

      event.preventDefault();

      if (
        swiperInstance &&
        !swiperInstance.destroyed
      ) {

        swiperInstance.slideTo(
          index,
          400
        );

      }

      return;

    }

    var thumbPrev =
      event.target.closest(
        '.variant-gallery__thumb-prev'
      );

    if (thumbPrev) {

      var prevGallery =
        thumbPrev.closest(
          '.variant-gallery'
        );

      if (!prevGallery) {
        return;
      }

      event.preventDefault();

      event.stopPropagation();

      var prevSwiperElement =
        prevGallery.querySelector(
          '.variant-gallery__swiper'
        );

      if (
        prevSwiperElement &&
        prevSwiperElement.swiper
      ) {

        prevSwiperElement.swiper.slidePrev();

      }

      return;

    }

    var thumbNext =
      event.target.closest(
        '.variant-gallery__thumb-next'
      );

    if (thumbNext) {

      var nextGallery =
        thumbNext.closest(
          '.variant-gallery'
        );

      if (!nextGallery) {
        return;
      }

      event.preventDefault();

      event.stopPropagation();

      var nextSwiperElement =
        nextGallery.querySelector(
          '.variant-gallery__swiper'
        );

      if (
        nextSwiperElement &&
        nextSwiperElement.swiper
      ) {

        nextSwiperElement.swiper.slideNext();

      }

      return;

    }

  }

  function handleThumbnailScroll(
    event
  ) {

    var prev =
      event.target.closest(
        '.variant-gallery__thumb-prev'
      );

    var next =
      event.target.closest(
        '.variant-gallery__thumb-next'
      );

    if (
      !prev &&
      !next
    ) {
      return;
    }

    event.preventDefault();

    var button =
      prev || next;

    var gallery =
      button.closest(
        '.variant-gallery'
      );

    if (!gallery) {
      return;
    }

    var thumbWindow =
      gallery.querySelector(
        '.variant-gallery__thumb-window'
      );

    if (!thumbWindow) {
      return;
    }

    if (window.innerWidth <= 767) {

      if (prev) {

        thumbWindow.scrollBy({
          left: -160,
          behavior: 'smooth'
        });

      }

      if (next) {

        thumbWindow.scrollBy({
          left: 160,
          behavior: 'smooth'
        });

      }

      return;
    }

    if (prev) {

      thumbWindow.scrollBy({
        top: -250,
        behavior: 'smooth'
      });

    }

    if (next) {

      thumbWindow.scrollBy({
        top: 250,
        behavior: 'smooth'
      });

    }

  }

  document.addEventListener(
    'click',
    function (event) {

      handlePackagingClick(
        event
      );

      handleClick(
        event
      );

      handleThumbnailScroll(
        event
      );

    }
  );

  document.addEventListener(
    'change',
    function (event) {

      handleVariantChange(
        event
      );

    }
  );

  function refresh() {

    var gallery =
      getGallery();

    if (!gallery) {
      return;
    }

    if (
      gallery !==
      lastGalleryElement
    ) {

      swiperInstance =
        null;

      lastGalleryElement =
        gallery;

    }

    scheduleGalleryUpdate(
      100
    );

  }

  var observer =
    new MutationObserver(
      function () {

        var gallery =
          getGallery();

        if (!gallery) {
          return;
        }

        if (
          gallery !==
          lastGalleryElement
        ) {

          refresh();

        }

      }
    );

  observer.observe(
    document.body,
    {
      childList: true,
      subtree: true
    }
  );

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      function () {

        refresh();

      }
    );

  } else {

    refresh();

  }

})();
</script>


