  <script>

 let isStickyActive = {% if section.settings.sticky_header %}true{% else %}false{% endif %};
let scrollHandler = null;
let currentHeader = null;

function initStickyHeader() {
  if (scrollHandler && currentHeader) {
    window.removeEventListener('scroll', scrollHandler);
    currentHeader.classList.remove('sticky-header');
  }

  const headerContent = document.querySelector('.header__content');
  if (!headerContent) return;
  if (window.Shopify && window.Shopify.designMode) {
    const currentStickyStatus = headerContent.dataset.stickyheader;
    if (currentStickyStatus !== undefined) {
      isStickyActive = currentStickyStatus === 'true';
    }
  }

  currentHeader = headerContent;
  const stickyOffset = headerContent.offsetTop;

  scrollHandler = function() {
    if (window.scrollY > stickyOffset && isStickyActive) {
      headerContent.classList.add('sticky-header');
    } else {
      headerContent.classList.remove('sticky-header');
    }
  };

  window.addEventListener('scroll', scrollHandler);
  scrollHandler();
}
document.addEventListener('DOMContentLoaded', function() {
  initStickyHeader();
});

if (window.Shopify && window.Shopify.designMode) {
  document.addEventListener('shopify:section:load', function(event) {
    if (event.target.querySelector('.header__content') || event.target.classList.contains('header-section')) {
      setTimeout(initStickyHeader, 100);
    }
  });

  document.addEventListener('shopify:section:select', function(event) {
    if (event.target.querySelector('.header__content') || event.target.classList.contains('header-section')) {
      setTimeout(initStickyHeader, 100);
    }
  });

  document.addEventListener('shopify:section:deselect', function(event) {
    if (event.target.querySelector('.header__content') || event.target.classList.contains('header-section')) {
      setTimeout(initStickyHeader, 100);
    }
  });

  document.addEventListener('shopify:section:reorder', function() {
    setTimeout(initStickyHeader, 150);
  });

  document.addEventListener('shopify:section:select', function(event) {
    const stickySettingInput = event.target.querySelector('[name*="sticky_header"]');
    if (stickySettingInput) {
      stickySettingInput.addEventListener('change', function() {
        setTimeout(initStickyHeader, 50);
      });
    }
  });

  if (document.readyState === 'complete') {
    setTimeout(initStickyHeader, 200);
  }
}
  </script>

