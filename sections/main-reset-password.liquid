{% style %}
  .main-reset-password{
    padding-top:120px;
    padding-bottom:120px;
  }
  @media screen and (max-width:768px){
  .main-reset-password{
    padding-top:60px;
    padding-bottom:60px;
  }
  }
  .form_container{
    width:35vw;
  }
  
  @media screen and (max-width:1400px){
  .form_container{
    width:65vw;
  }
  }
  @media screen and (max-width:768px){
    .form_container{
      width:80vw;
    }
  }
{% endstyle %}

<div class="main-reset-password container">
  <div class="mx-auto form_container">
    <h1 class="text-center mb-4">{{ 'customer.recover_password.title' | t }}</h1>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href="#{{ field }}">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="password mb-4">
        <label for="password" class="mb-3 h4">{{ 'customer.reset_password.password' | t }}*</label>
        <input
          type="password"
          name="customer[password]"
          id="password"
          class="form-control"
        >
      </div>
      <div class="password_confirm mb-4">
        <label for="password_confirmation" class="mb-3 h4">{{ 'customer.reset_password.confirm_password' | t }}*</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="password_confirmation"
          class="form-control"
        >
      </div>
      <button class="btn btn-primary rounded-pill">{{ 'general.password_page.reset_button_text' | t }}</button>
    {%- endform -%}
  </div>
</div>
