          "value": "normal",
          "label": "t:sections.featured-blog.settings.blog_alignment.options__1.label"
        },
        {
          "value": "stepped",
          "label": "t:sections.featured-blog.settings.blog_alignment.options__2.label"
        }
      ],
      "default": "stepped",
      "label": "t:sections.featured-blog.settings.blog_alignment.label"
    },
    {
      "type": "select",
      "id": "desktop_column",
      "options": [
        {
          "value": "2",
          "label": "t:settings_schema.card.settings.desktop_column.options__1.label"
        },
        {
          "value": "3",
          "label": "t:settings_schema.card.settings.desktop_column.options__2.label"
        }
      ],
      "default": "2",
      "label": "t:settings_schema.card.settings.desktop_column.label"
    },
    {
      "type": "select",
      "id": "blog_aspect_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:settings_schema.card.settings.card_aspect_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:settings_schema.card.settings.card_aspect_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.blog_post_card.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_excerpts",
      "label": "t:sections.main-blog.settings.show_excerpts.label"
    },

    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "t:sections.main-blog.settings.show_comments.label"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "t:sections.featured-blog.settings.show_tag.label"
    },
    {
      "type": "checkbox",
      "id": "readmore_button",
      "label": "t:sections.featured-blog.settings.readmore_button.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing.spacing_heading"
    },
    {
      "type": "range",
      "id": "top_space",
